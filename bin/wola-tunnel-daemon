#!/data/data/com.termux/files/usr/bin/bash
# =================================================================
# Wolarc Autonomous Tunnel Watchdog Daemon
# Maintains persistent, self-healing remote tunnel connectivity.
# Supports: Cloudflare Quick Tunnels, localhost.run, serveo.net, pinggy.io
# =================================================================

CONFIG="$HOME/.wolarc"
[ -f "$CONFIG" ] && source "$CONFIG"

URL_FILE="$HOME/.wola/run/wola_url"
PROVIDER_FILE="$HOME/.wola/run/wola_provider"
ENDPOINT_FILE="$HOME/.wola/run/wola_endpoint"
LOG_FILE="$HOME/.wola/logs/tunnel.log"
PID_FILE="$HOME/.wola/run/wola_tunnel_daemon.pid"
LOCK_FILE="$HOME/.wola/run/wola.lock"
RUN_DIR="$HOME/.wola/run"
mkdir -p "$RUN_DIR" "$HOME/.wola/logs" 2>/dev/null

PORT="${AGENT_PORT:-5000}"
PREF_PROVIDER="${TUNNEL_PROVIDER:-auto}"

# Runner for detaching processes cleanly
runner=""
command -v setsid >/dev/null 2>&1 && runner="setsid -f"

log_msg() {
    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    echo "[$ts] [Tunnel Watchdog] $1" >> "$LOG_FILE"
}

is_local_api_ready() {
    local code
    code=$(curl -s -m 3 -o /dev/null -w "%{http_code}" "http://127.0.0.1:${PORT}/health" 2>/dev/null)
    [ "$code" = "200" ] || [ "$code" = "204" ]
}

is_internet_available() {
    curl -s -m 2 -o /dev/null "http://connectivitycheck.gstatic.com/generate_204" 2>/dev/null || \
    curl -s -m 2 -o /dev/null "https://1.1.1.1" 2>/dev/null || \
    curl -s -m 2 -o /dev/null "https://www.cloudflare.com" 2>/dev/null
}

kill_tunnel_processes() {
    pkill -9 -f "ssh.*localhost.run" 2>/dev/null || true
    pkill -9 -f "ssh.*serveo.net" 2>/dev/null || true
    pkill -9 -f "ssh.*pinggy" 2>/dev/null || true
    pkill -9 -f "cloudflared.*tunnel.*5000" 2>/dev/null || true
    pkill -9 -f "cloudflared.*tunnel.*localhost" 2>/dev/null || true
}

start_single_tunnel() {
    local prov="$1"
    kill_tunnel_processes
    sleep 1

    local tmp_log="$RUN_DIR/wola_tunnel_tmp.log"
    rm -f "$tmp_log"

    case "$prov" in
        "cloudflare")
            if ! command -v cloudflared >/dev/null 2>&1; then
                return 1
            fi
            $runner cloudflared tunnel --url "http://127.0.0.1:${PORT}" > "$tmp_log" 2>&1 &
            ;;
        "serveo")
            $runner ssh -o StrictHostKeyChecking=no \
                      -o ServerAliveInterval=10 \
                      -o ServerAliveCountMax=3 \
                      -o TCPKeepAlive=yes \
                      -o IPQoS=lowdelay \
                      -o Compression=no \
                      -o ExitOnForwardFailure=yes \
                      -R 80:localhost:${PORT} \
                      serveo.net > "$tmp_log" 2>&1 &
            ;;
        "pinggy")
            $runner ssh -o StrictHostKeyChecking=no \
                      -o ServerAliveInterval=10 \
                      -o ServerAliveCountMax=3 \
                      -o TCPKeepAlive=yes \
                      -o IPQoS=lowdelay \
                      -o Compression=no \
                      -o ExitOnForwardFailure=yes \
                      -R 0:localhost:${PORT} \
                      a.pinggy.io > "$tmp_log" 2>&1 &
            ;;
        "localhost.run"|*)
            $runner ssh -o StrictHostKeyChecking=no \
                      -o ServerAliveInterval=10 \
                      -o ServerAliveCountMax=3 \
                      -o TCPKeepAlive=yes \
                      -o IPQoS=lowdelay \
                      -o Compression=no \
                      -o ExitOnForwardFailure=yes \
                      -R 80:localhost:${PORT} \
                      nokey@localhost.run > "$tmp_log" 2>&1 &
            ;;
    esac

    local extracted_url=""
    for i in {1..14}; do
        case "$prov" in
            "cloudflare")
                extracted_url=$(grep -oE "https://[a-zA-Z0-9.-]+\.trycloudflare\.com" "$tmp_log" 2>/dev/null | tail -n 1)
                ;;
            "serveo")
                extracted_url=$(grep -oE "https://[a-zA-Z0-9.-]+\.serveo\.net" "$tmp_log" 2>/dev/null | tail -n 1)
                ;;
            "pinggy")
                extracted_url=$(grep -oE "https://[a-zA-Z0-9.-]+\.(?:free\.)?pinggy\.link" "$tmp_log" 2>/dev/null | tail -n 1)
                ;;
            "localhost.run"|*)
                extracted_url=$(grep -oE "https://[a-zA-Z0-9.-]+\.lhr\.life" "$tmp_log" 2>/dev/null | grep -v "admin" | tail -n 1)
                ;;
        esac

        if [ -n "$extracted_url" ]; then
            break
        fi
        sleep 1
    done

    if [ -n "$extracted_url" ]; then
        cat "$tmp_log" >> "$LOG_FILE" 2>/dev/null
        rm -f "$tmp_log"
        echo "$extracted_url" > "$URL_FILE"
        echo "${extracted_url}/v1" > "$ENDPOINT_FILE"
        echo "$prov" > "$PROVIDER_FILE"
        log_msg "Established tunnel via ${prov}: ${extracted_url}"
        echo "$extracted_url"
        return 0
    else
        cat "$tmp_log" >> "$LOG_FILE" 2>/dev/null
        rm -f "$tmp_log"
        kill_tunnel_processes
        return 1
    fi
}

reconnect_cascade() {
    local target_provider="$1"
    local candidates=()

    if [ -n "$target_provider" ] && [ "$target_provider" != "auto" ]; then
        candidates=("$target_provider")
    else
        # Preferred order: cloudflare (if installed) -> localhost.run -> serveo -> pinggy
        if command -v cloudflared >/dev/null 2>&1; then
            candidates+=("cloudflare")
        fi
        candidates+=("localhost.run" "serveo" "pinggy")
    fi

    for candidate in "${candidates[@]}"; do
        log_msg "Attempting tunnel provider: ${candidate}..."
        local url
        url=$(start_single_tunnel "$candidate")
        if [ $? -eq 0 ] && [ -n "$url" ]; then
            log_msg "Tunnel active and verified: ${url} (${candidate})"
            echo "$url"
            return 0
        fi
        log_msg "Provider ${candidate} failed or timed out. Trying next candidate..."
    done

    log_msg "All tunnel providers exhausted without success."
    rm -f "$URL_FILE" "$ENDPOINT_FILE" "$HOME/.wola_url" "$HOME/.wola_endpoint"
    echo "offline" > "$PROVIDER_FILE"
    return 1
}

test_tunnel_health() {
    local url="$1"
    if [ -z "$url" ]; then
        return 1
    fi
    local code
    code=$(curl -s -m 6 -o /dev/null -w "%{http_code}" "${url}/health" 2>/dev/null)
    if [ "$code" = "200" ] || [ "$code" = "204" ]; then
        return 0
    fi
    return 1
}

watchdog_worker() {
    log_msg "Starting background watchdog loop (PID $$)..."
    echo "$$" > "$PID_FILE"

    local fail_count=0
    local offline_backoff=20
    local was_offline=false

    while true; do
        # Exit if node lock is gone
        if [ ! -f "$LOCK_FILE" ] && [ ! -f "$HOME/.wola.lock" ]; then
            log_msg "Wola node lock removed. Exiting watchdog cleanly."
            kill_tunnel_processes
            rm -f "$PID_FILE" "$HOME/.wola_tunnel_daemon.pid"
            exit 0
        fi

        # If local API is not ready, wait without counting failure
        if ! is_local_api_ready; then
            sleep 10
            continue
        fi

        local cur_url=""
        if [ -f "$URL_FILE" ]; then
            cur_url=$(cat "$URL_FILE" | tr -d ' \n\r')
        elif [ -f "$HOME/.wola_url" ]; then
            cur_url=$(cat "$HOME/.wola_url" | tr -d ' \n\r')
        fi

        # Check process existence
        local cur_prov="localhost.run"
        if [ -f "$PROVIDER_FILE" ]; then
            cur_prov=$(cat "$PROVIDER_FILE" | tr -d ' \n\r')
        elif [ -f "$HOME/.wola_provider" ]; then
            cur_prov=$(cat "$HOME/.wola_provider" | tr -d ' \n\r')
        fi

        # If currently marked offline or URL missing
        if [ "$cur_prov" = "offline" ] || [ -z "$cur_url" ]; then
            if ! is_internet_available; then
                if [ "$was_offline" = false ]; then
                    log_msg "Internet connectivity offline. Entering battery-saver backoff mode (${offline_backoff}s)..."
                    was_offline=true
                fi
                sleep "$offline_backoff"
                if [ "$offline_backoff" -lt 300 ]; then
                    offline_backoff=$((offline_backoff * 2))
                    [ "$offline_backoff" -gt 300 ] && offline_backoff=300
                fi
                continue
            else
                if [ "$was_offline" = true ]; then
                    log_msg "Internet connectivity restored! Reconnecting remote tunnel..."
                    was_offline=false
                fi
                offline_backoff=20
                fail_count=2
            fi
        fi

        local proc_alive=false
        if [ "$cur_prov" = "cloudflare" ]; then
            pgrep -f "cloudflared.*tunnel" >/dev/null 2>&1 && proc_alive=true
        elif [ "$cur_prov" != "offline" ]; then
            pgrep -f "ssh.*${cur_prov}" >/dev/null 2>&1 && proc_alive=true
        fi

        if [ "$proc_alive" = false ] || [ -z "$cur_url" ]; then
            fail_count=$((fail_count + 1))
            log_msg "Tunnel process not alive or URL missing (fail_count=$fail_count)."
        elif ! test_tunnel_health "$cur_url"; then
            fail_count=$((fail_count + 1))
            log_msg "Tunnel URL health ping failed: ${cur_url} (fail_count=$fail_count)."
        else
            fail_count=0
            was_offline=false
            offline_backoff=20
        fi

        if [ $fail_count -ge 2 ]; then
            if ! is_internet_available; then
                log_msg "Tunnel down and Internet is unreachable. Setting provider to offline."
                echo "offline" > "$PROVIDER_FILE"
                rm -f "$URL_FILE" "$ENDPOINT_FILE" "$HOME/.wola_url" "$HOME/.wola_endpoint"
                kill_tunnel_processes
                was_offline=true
                offline_backoff=30
                fail_count=0
            else
                log_msg "2 consecutive tunnel failures detected with WAN active. Triggering auto-reconnect..."
                reconnect_cascade "$PREF_PROVIDER"
                fail_count=0
            fi
        fi

        sleep 20
    done
}

case "$1" in
    "start")
        # Ensure only one watchdog instance
        local active_pid=""
        [ -f "$PID_FILE" ] && active_pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -z "$active_pid" ] && [ -f "$HOME/.wola_tunnel_daemon.pid" ] && active_pid=$(cat "$HOME/.wola_tunnel_daemon.pid" 2>/dev/null)

        if [ -n "$active_pid" ] && kill -0 "$active_pid" 2>/dev/null; then
            # Already running
            if [ -f "$URL_FILE" ]; then
                cat "$URL_FILE"
            elif [ -f "$HOME/.wola_url" ]; then
                cat "$HOME/.wola_url"
            fi
            exit 0
        fi

        new_url=$(reconnect_cascade "$PREF_PROVIDER")
        res=$?
        if command -v setsid >/dev/null 2>&1; then
            setsid -f "$0" run-watchdog >/dev/null 2>&1
        else
            nohup "$0" run-watchdog >/dev/null 2>&1 &
        fi
        disown 2>/dev/null || true

        if [ $res -eq 0 ]; then
            echo "$new_url"
            exit 0
        else
            exit 1
        fi
        ;;

    "run-watchdog")
        watchdog_worker
        ;;

    "stop")
        for pf in "$PID_FILE" "$HOME/.wola_tunnel_daemon.pid"; do
            if [ -f "$pf" ]; then
                w_pid=$(cat "$pf" 2>/dev/null)
                if [ -n "$w_pid" ]; then
                    kill -9 "$w_pid" 2>/dev/null || true
                fi
                rm -f "$pf"
            fi
        done
        kill_tunnel_processes
        rm -f "$URL_FILE" "$ENDPOINT_FILE" "$PROVIDER_FILE" \
              "$HOME/.wola_url" "$HOME/.wola_endpoint" "$HOME/.wola_provider"
        log_msg "Tunnel watchdog and forwarders stopped."
        exit 0
        ;;

    "reconnect")
        log_msg "Manual reconnect triggered."
        target="$2"
        [ -z "$target" ] && target="$PREF_PROVIDER"
        reconnect_cascade "$target"
        # Ensure watchdog worker is running
        need_spawn=true
        local chk_pid=""
        [ -f "$PID_FILE" ] && chk_pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -z "$chk_pid" ] && [ -f "$HOME/.wola_tunnel_daemon.pid" ] && chk_pid=$(cat "$HOME/.wola_tunnel_daemon.pid" 2>/dev/null)
        if [ -n "$chk_pid" ] && kill -0 "$chk_pid" 2>/dev/null; then
            need_spawn=false
        fi
        if [ "$need_spawn" = true ]; then
            if command -v setsid >/dev/null 2>&1; then
                setsid -f "$0" run-watchdog >/dev/null 2>&1
            else
                nohup "$0" run-watchdog >/dev/null 2>&1 &
            fi
            disown 2>/dev/null || true
        fi
        ;;

    "status")
        echo "=================================================="
        echo "         WOLA TUNNEL WATCHDOG STATUS"
        echo "=================================================="
        local cur_pid=""
        [ -f "$PID_FILE" ] && cur_pid=$(cat "$PID_FILE" 2>/dev/null)
        [ -z "$cur_pid" ] && [ -f "$HOME/.wola_tunnel_daemon.pid" ] && cur_pid=$(cat "$HOME/.wola_tunnel_daemon.pid" 2>/dev/null)

        if [ -n "$cur_pid" ]; then
            if kill -0 "$cur_pid" 2>/dev/null; then
                echo "  Watchdog Daemon : RUNNING (PID $cur_pid)"
            else
                echo "  Watchdog Daemon : STOPPED (stale PID)"
            fi
        else
            echo "  Watchdog Daemon : STOPPED"
        fi

        local stat_url=""
        local stat_prov=""
        local stat_end=""
        if [ -f "$URL_FILE" ]; then
            stat_url=$(cat "$URL_FILE" 2>/dev/null)
            stat_prov=$(cat "$PROVIDER_FILE" 2>/dev/null)
            stat_end=$(cat "$ENDPOINT_FILE" 2>/dev/null)
        elif [ -f "$HOME/.wola_url" ]; then
            stat_url=$(cat "$HOME/.wola_url" 2>/dev/null)
            stat_prov=$(cat "$HOME/.wola_provider" 2>/dev/null)
            stat_end=$(cat "$HOME/.wola_endpoint" 2>/dev/null)
        fi

        if [ -n "$stat_url" ]; then
            echo "  Active URL      : $stat_url"
            echo "  Provider        : ${stat_prov:-Unknown}"
            echo "  Endpoint        : ${stat_end:-Unknown}"
            echo -n "  Latency Health  : "
            if test_tunnel_health "$stat_url"; then
                echo "HEALTHY (200 OK)"
            else
                echo "UNREACHABLE / DEGRADED"
            fi
        else
            echo "  Active URL      : OFFLINE"
        fi
        echo "=================================================="
        ;;

    *)
        echo "Usage: wola-tunnel-daemon [start|stop|reconnect|status|run-watchdog]"
        exit 1
        ;;
esac
