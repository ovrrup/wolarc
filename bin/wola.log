#!/data/data/com.termux/files/usr/bin/bash

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"

tail_log() {
    local name="$1"
    local file="$2"
    if [ ! -f "$file" ]; then
        echo -e "${C_YELLOW}[!] Log file $file does not exist yet.${C_RESET}"
        return
    fi
    echo -e "${C_CYAN}=== Tailing ${C_BOLD}${name}${C_RESET} (${file}) ===${C_RESET}"
    tail -f -n 30 "$file"
}

case "$1" in
    "chat")
        tail_log "Chat LLM Engine" "$HOME/chat.log"
        ;;
    "embed")
        tail_log "Embedding Engine" "$HOME/embed.log"
        ;;
    "agent"|"api")
        tail_log "Agent API Gateway" "$HOME/agent.log"
        ;;
    "tunnel")
        tail_log "Remote Tunnel" "$HOME/tunnel.log"
        ;;
    "indexer"|"rag")
        tail_log "Document Indexer" "$HOME/indexer.log"
        ;;
    "think")
        tail_log "Thinking Stream" "$HOME/.wola_thinking.log"
        ;;
    *)
        echo -e "${C_CYAN}╭────────────────────────────────────────────────────────────────╮${C_RESET}"
        echo -e "${C_CYAN}│${C_RESET}                 ${C_BOLD}WOLARC LOG MONITOR & DIAGNOSTICS${C_RESET}               ${C_CYAN}│${C_RESET}"
        echo -e "${C_CYAN}╰────────────────────────────────────────────────────────────────╯${C_RESET}"
        
        for item in "Chat LLM:chat.log" "Embed Engine:embed.log" "Agent API:agent.log" "Tunnel:tunnel.log" "Indexer:indexer.log"; do
            title="${item%%:*}"
            fname="${item##*:}"
            fpath="$HOME/$fname"
            echo -e "\n${C_BOLD}${title}${C_RESET} (${C_DIM}tail -n 3 $fpath${C_RESET}):"
            if [ -f "$fpath" ]; then
                tail -n 3 "$fpath" | sed 's/^/  /'
            else
                echo -e "  ${C_DIM}(no log created yet)${C_RESET}"
            fi
        done
        echo -e "\n${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_BOLD}Live Follow Mode:${C_RESET}"
        echo -e "    wola.log chat      • Follow Chat engine log"
        echo -e "    wola.log embed     • Follow Embedding engine log"
        echo -e "    wola.log agent     • Follow Agent API Gateway log"
        echo -e "    wola.log tunnel    • Follow SSH remote tunnel log"
        echo -e "    wola.log indexer   • Follow Background note indexer"
        echo -e "${C_CYAN}=================================================================${C_RESET}"
        ;;
esac
