def create_session():
    session = requests.Session()
    retries = Retry(total=3, backoff_factor=0.5, status_forcelist=[500, 502, 503, 504], raise_on_status=False)
    adapter = HTTPAdapter(max_retries=retries, pool_connections=5, pool_maxsize=10)
    session.mount("https://", adapter)
    session.mount("http://", adapter)
    return session

HTTP = create_session()

def get_ram_info():
    total_mb, avail_mb = 0, 0
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    total_mb = int(line.split()[1]) // 1024
                elif line.startswith("MemAvailable:"):
                    avail_mb = int(line.split()[1]) // 1024
    except Exception:
        pass
    return total_mb, avail_mb

def format_bytes(b):
    if b >= 1024 * 1024 * 1024:
        return f"{b / (1024 * 1024 * 1024):.2f} GB"
    elif b >= 1024 * 1024:
        return f"{b / (1024 * 1024):.1f} MB"
    return f"{b / 1024:.1f} KB"

def get_active_models():
    chat_active, embed_active = "", ""
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                for line in f:
                    if line.startswith("CHAT_MODEL="):
                        chat_active = line.split("=", 1)[1].strip("\"' \n")
                    elif line.startswith("EMBED_MODEL="):
                        embed_active = line.split("=", 1)[1].strip("\"' \n")
        except Exception:
            pass
    return chat_active, embed_active

def verify_security(repo_id, filename, pipeline_tag, intended_type):
    target = f"{repo_id} {filename}".lower()
    is_embed = any(kw in target for kw in EMBED_KEYWORDS) or (pipeline_tag in EMBED_PIPELINES)

    if intended_type == "embed":
        if not is_embed:
            print(f"\n{C_RED}[SECURITY / COMPATIBILITY BLOCKED]{C_RESET}")
            print(f"Target '{filename}' is NOT an embedding model.")
            print(f"Detected pipeline: {pipeline_tag or 'Text Generation'}")
            print("Chat models cannot generate dense vector embeddings for RAG.")
            return False
    elif intended_type == "chat":
        if is_embed:
            print(f"\n{C_YELLOW}[WARNING]{C_RESET} This model is an embedding encoder.")
            confirm = input(f"{C_BOLD}Force assign as chat model anyway? (y/N): {C_RESET}").strip().lower()
            return confirm == "y"
    return True

def assess_ram_safety(file_size_bytes, non_interactive=False):
    if not file_size_bytes:
        return True
    _, avail_mb = get_ram_info()
    if avail_mb <= 0:
        return True
    
    needed_mb = (file_size_bytes / (1024 * 1024)) * 1.25
    if needed_mb > avail_mb:
        print(f"\n{C_RED}[RAM WARNING]{C_RESET} This model requires ~{needed_mb:.0f} MB RAM.")
        print(f"Your device only has {avail_mb} MB available right now.")
        if non_interactive or not sys.stdin.isatty():
            return True
        confirm = input(f"{C_BOLD}Proceed with download anyway? (y/N): {C_RESET}").strip().lower()
        if confirm != "y":
            return False
    return True

def download_file(url, target_filename, file_size=None, non_interactive=False):
    dest_path = os.path.join(MODELS_DIR, target_filename)
    downloaded_existing = 0

    if os.path.exists(dest_path):
        downloaded_existing = os.path.getsize(dest_path)
        if file_size and downloaded_existing >= file_size:
            print(f"{C_GREEN}[*] File already fully downloaded:{C_RESET} {dest_path}")
            return dest_path
        elif downloaded_existing > 0:
            print(f"{C_YELLOW}[*] Incomplete download found ({format_bytes(downloaded_existing)}).{C_RESET}")
            if non_interactive or not sys.stdin.isatty():
                ans = "r"
            else:
                ans = input("Resume download [r], Overwrite [o], or Cancel [c]? (R/o/c): ").strip().lower()
            if ans in ["c", "cancel"]:
                return None
            elif ans in ["o", "overwrite"]:
                os.remove(dest_path)
                downloaded_existing = 0

    if file_size and not assess_ram_safety(file_size, non_interactive=non_interactive):
        return None

    headers = {}
    mode = "wb"
    if downloaded_existing > 0:
        headers["Range"] = f"bytes={downloaded_existing}-"
        mode = "ab"

    print(f"\n{C_CYAN}[*] Fetching:{C_RESET} {target_filename}")
    try:
        with HTTP.get(url, headers=headers, stream=True, timeout=(5, 30)) as r:
            if r.status_code not in [200, 206]:
                print(f"{C_RED}[-] Server responded with status {r.status_code}{C_RESET}")
                return None

            total_length = r.headers.get("content-length")
            total_bytes = (int(total_length) + downloaded_existing) if total_length else file_size

            downloaded = downloaded_existing
            start_time = time.time()
            last_render_time = 0

            with open(dest_path, mode) as f:
                for chunk in r.iter_content(chunk_size=1024 * 1024):
                    if chunk:
                        f.write(chunk)
                        downloaded += len(chunk)
                        now = time.time()

                        if now - last_render_time >= 0.25:
                            last_render_time = now
                            if total_bytes:
                                pct = (downloaded / total_bytes) * 100
                                spd = (downloaded - downloaded_existing) / max(now - start_time, 0.001) / (1024 * 1024)
                                sys.stdout.write(f"\r  [{pct:5.1f}%] {format_bytes(downloaded)} / {format_bytes(total_bytes)} @ {spd:4.1f} MB/s ")
                            else:
                                sys.stdout.write(f"\r  Downloaded: {format_bytes(downloaded)}")
                            sys.stdout.flush()

            print(f"\n{C_GREEN}[+] Completed:{C_RESET} {target_filename}")
            return dest_path
    except Exception as e:
        print(f"\n{C_RED}[-] Download interrupted: {e}{C_RESET}")
        return None

def apply_to_config(filename, model_type, prompt_confirm=True):
    if prompt_confirm:
        confirm = input(f"\n{C_BOLD}Activate '{filename}' as your active {model_type.upper()} model in ~/.wolarc? (Y/n): {C_RESET}").strip().lower()
        if confirm not in ["", "y", "yes"]:
            return
    key = "CHAT_MODEL" if model_type == "chat" else "EMBED_MODEL"
    cfg = os.path.expanduser("~/.wolarc")
    if os.path.exists(cfg):
        try:
            with open(cfg, "r") as f:
                lines = f.readlines()
            pattern = re.compile(rf"^\s*{re.escape(key)}\s*=.*$")
            found = False
            new_lines = []
            for line in lines:
                if pattern.match(line):
                    new_lines.append(f'{key}="{filename}"\n')
                    found = True
                else:
                    new_lines.append(line)
            if not found:
                new_lines.append(f'{key}="{filename}"\n')
            with open(cfg, "w") as f:
                f.writelines(new_lines)
            print(f"{C_GREEN}[+] Activated {model_type.upper()} Model -> {filename} in ~/.wolarc{C_RESET}")
            return
        except Exception as e:
            print(f"{C_RED}[-] Direct config write failed: {e}{C_RESET}")
    # Fallback to wola.m if available
    os.system(f"wola.m {model_type} \"{filename}\" 2>/dev/null")

def inspect_repo_and_download(repo_id, pipeline_tag=""):
    print(f"\n{C_CYAN}[*] Fetching file tree for {repo_id}...{C_RESET}")
    tree_url = f"https://huggingface.co/api/models/{repo_id}/tree/main"
    try:
        res = HTTP.get(tree_url, timeout=(4, 10))
        if res.status_code != 200:
            print(f"{C_RED}[-] Could not reach repo tree (HTTP {res.status_code}).{C_RESET}")
            return

        entries = res.json()
        gguf_files = [
            {"name": item["path"], "size": item.get("size", 0)} 
            for item in entries 
            if item.get("path", "").lower().endswith(".gguf")
        ]

        if not gguf_files:
            print(f"{C_YELLOW}[-] No .gguf files found in this repository branch.{C_RESET}")
            return

        gguf_files.sort(key=lambda x: ("q4" not in x["name"].lower(), x["name"]))

        print(f"\n{C_CYAN}================================================================={C_RESET}")
        print(f"  GGUF FILES IN {C_BOLD}{repo_id}{C_RESET}")
        print(f"{C_CYAN}================================================================={C_RESET}")
        for idx, item in enumerate(gguf_files, 1):
            sz_str = format_bytes(item["size"]) if item["size"] > 0 else "Unknown size"
            print(f"  {C_BOLD}[{idx:2d}]{C_RESET} {item['name']:<42} {C_YELLOW}{sz_str:>10}{C_RESET}")
        print(f"  {C_BOLD}[ 0]{C_RESET} Cancel")
        print(f"{C_CYAN}-----------------------------------------------------------------{C_RESET}")

        sel = input(f"{C_BOLD}Select file [1-{len(gguf_files)}]: {C_RESET}").strip()
        if not sel.isdigit() or int(sel) < 1 or int(sel) > len(gguf_files):
            return

        chosen = gguf_files[int(sel) - 1]
        role_input = input(f"{C_BOLD}Set role: [c]hat or [e]mbed? (c/e): {C_RESET}").strip().lower()
        role = "embed" if role_input.startswith("e") else "chat"

        if verify_security(repo_id, chosen["name"], pipeline_tag, role):
            url = f"https://huggingface.co/{repo_id}/resolve/main/{chosen['name']}"
            dest = download_file(url, chosen["name"], chosen["size"])
            if dest:
                apply_to_config(chosen["name"], role)
    except Exception as e:
        print(f"{C_RED}[-] Network error: {e}{C_RESET}")

def search_huggingface():
    print(f"\n{C_CYAN}================================================================={C_RESET}")
    print(f"               SEARCH HUGGING FACE REPOSITORIES")
    print(f"{C_CYAN}================================================================={C_RESET}")
    query = input(f"{C_BOLD}Search (e.g. 'qwen 2.5', 'phi-4', 'bge', 'gemma 2'): {C_RESET}").strip()
    if not query:
        return

    print(f"{C_DIM}[*] Searching...{C_RESET}")
    api_url = f"https://huggingface.co/api/models?search={query}&filter=gguf&sort=downloads&direction=-1&limit=8&full=false"
    
    try:
        res = HTTP.get(api_url, timeout=(4, 10))
        if res.status_code != 200:
            print(f"{C_RED}[-] API query failed (HTTP {res.status_code}).{C_RESET}")
            return
        results = res.json()
        if not results:
            print(f"{C_YELLOW}[-] No GGUF models matched '{query}'.{C_RESET}")
            return

        print(f"\n{C_CYAN}-----------------------------------------------------------------{C_RESET}")
        for idx, item in enumerate(results, 1):
            m_id = item.get("id", "Unknown")
            downloads = item.get("downloads", 0)
            p_tag = item.get("pipeline_tag", "chat/other")
            print(f"  {C_BOLD}[{idx:2d}]{C_RESET} {C_GREEN}{m_id}{C_RESET}")
            print(f"       {C_DIM}Task: {p_tag} | Downloads: {downloads:,}{C_RESET}")
        print(f"  {C_BOLD}[ 0]{C_RESET} Back to Menu")
        print(f"{C_CYAN}-----------------------------------------------------------------{C_RESET}")

        sel = input(f"{C_BOLD}Select repo [1-{len(results)}]: {C_RESET}").strip()
        if not sel.isdigit() or int(sel) < 1 or int(sel) > len(results):
            return

        chosen = results[int(sel) - 1]
        inspect_repo_and_download(chosen["id"], chosen.get("pipeline_tag", ""))
    except Exception as e:
        print(f"{C_RED}[-] Search error: {e}{C_RESET}")

def menu_curated(model_list, model_type):
    print(f"\n{C_CYAN}================================================================={C_RESET}")
    print(f"       TESTED {model_type.upper()} MODELS FOR ANDROID")
    print(f"{C_CYAN}================================================================={C_RESET}")
    for idx, m in enumerate(model_list, 1):
        print(f"  {C_BOLD}[{idx}]{C_RESET} {C_GREEN}{m['name']}{C_RESET} ({m['size']})")
        print(f"      {m['desc']}")
    print(f"  {C_BOLD}[0]{C_RESET} Back to Menu")
    print(f"{C_CYAN}-----------------------------------------------------------------{C_RESET}")

    choice = input(f"Select [1-{len(model_list)}]: ").strip()
    if not choice.isdigit() or int(choice) < 1 or int(choice) > len(model_list):
        return

    selected = model_list[int(choice) - 1]
    url = f"https://huggingface.co/{selected['repo']}/resolve/main/{selected['file']}"
    
    if verify_security(selected["repo"], selected["file"], "", model_type):
        dest = download_file(url, selected["file"])
        if dest:
            apply_to_config(selected["file"], model_type)

def menu_delete():
    chat_active, embed_active = get_active_models()
    files = [f for f in os.listdir(MODELS_DIR) if f.lower().endswith(".gguf")]
    files.sort()

    if not files:
        print(f"\n{C_YELLOW}[-] No .gguf models found in {MODELS_DIR}.{C_RESET}")
        return

    print(f"\n{C_RED}================================================================={C_RESET}")
    print(f"               {C_BOLD}DELETE DOWNLOADED MODELS{C_RESET}")
    print(f"{C_RED}================================================================={C_RESET}")
    for idx, f in enumerate(files, 1):
        fpath = os.path.join(MODELS_DIR, f)
        sz_str = format_bytes(os.path.getsize(fpath))
        tag = ""
        if f == chat_active and f == embed_active:
            tag = f" {C_YELLOW}[ACTIVE CHAT & EMBED]{C_RESET}"
        elif f == chat_active:
            tag = f" {C_YELLOW}[ACTIVE CHAT]{C_RESET}"
        elif f == embed_active:
            tag = f" {C_YELLOW}[ACTIVE EMBED]{C_RESET}"
        print(f"  {C_BOLD}[{idx:2d}]{C_RESET} {f} ({sz_str}){tag}")
    print(f"  {C_BOLD}[ 0]{C_RESET} Back to Menu")
    print(f"{C_RED}-----------------------------------------------------------------{C_RESET}")

    sel = input(f"{C_BOLD}Select file to delete [1-{len(files)}]: {C_RESET}").strip()
    if not sel.isdigit() or int(sel) < 1 or int(sel) > len(files):
        return

    target_file = files[int(sel) - 1]
    target_path = os.path.join(MODELS_DIR, target_file)

    if target_file in [chat_active, embed_active]:
        print(f"\n{C_RED}[ALERT] '{target_file}' is currently configured as an ACTIVE model!{C_RESET}")

    confirm = input(f"{C_BOLD}Permanently delete '{target_file}'? (y/N): {C_RESET}").strip().lower()
    if confirm == "y":
        try:
            os.remove(target_path)
            print(f"{C_GREEN}[+] Deleted '{target_file}'.{C_RESET}")
            if target_file == chat_active:
                os.system("wola.t CHAT_MODEL \"\"")
            if target_file == embed_active:
                os.system("wola.t EMBED_MODEL \"\"")
        except Exception as e:
            print(f"{C_RED}[-] Deletion failed: {e}{C_RESET}")

def copy_with_progress(src, dst):
    total_bytes = os.path.getsize(src)
    copied = 0
    start_time = time.time()
    last_render = 0
    with open(src, "rb") as fsrc, open(dst, "wb") as fdst:
        while True:
            buf = fsrc.read(4 * 1024 * 1024)
            if not buf:
                break
            fdst.write(buf)
            copied += len(buf)
            now = time.time()
            if now - last_render >= 0.25:
                last_render = now
                pct = (copied / max(1, total_bytes)) * 100
                spd = copied / max(0.001, now - start_time) / (1024 * 1024)
                sys.stdout.write(f"\r  Copying: [{pct:5.1f}%] {format_bytes(copied)} / {format_bytes(total_bytes)} @ {spd:4.1f} MB/s ")
                sys.stdout.flush()
    print(f"\r  Copying: [100.0%] {format_bytes(total_bytes)} complete!               ")

def menu_import_local(initial_path=None):
    print(f"\n{C_CYAN}================================================================={C_RESET}")
    print(f"             {C_BOLD}IMPORT LOCAL GGUF MODEL FROM STORAGE{C_RESET}")
    print(f"{C_CYAN}================================================================={C_RESET}")
    
    if not initial_path:
        target_input = input(f"{C_BOLD}Enter path to GGUF file or directory: {C_RESET}").strip()
    else:
        target_input = initial_path.strip()

    if not target_input:
        return

    resolved_path = os.path.expanduser(os.path.expandvars(target_input.strip("\"' ")))
    if not os.path.exists(resolved_path):
        print(f"{C_RED}[-] Path does not exist: {resolved_path}{C_RESET}")
        return

    # If user provided a directory, scan for .gguf files
    if os.path.isdir(resolved_path):
        found = [f for f in os.listdir(resolved_path) if f.lower().endswith(".gguf")]
        if not found:
            print(f"{C_YELLOW}[-] No .gguf files found in {resolved_path}{C_RESET}")
            return
        print(f"\n{C_CYAN}GGUF models found in {resolved_path}:{C_RESET}")
        for idx, f in enumerate(found, 1):
            f_size = os.path.getsize(os.path.join(resolved_path, f))
            print(f"  {C_BOLD}[{idx}]{C_RESET} {f} ({format_bytes(f_size)})")
        print(f"  {C_BOLD}[0]{C_RESET} Cancel")
        sel = input(f"{C_BOLD}Select file [1-{len(found)}]: {C_RESET}").strip()
        if not sel.isdigit() or int(sel) < 1 or int(sel) > len(found):
            return
        chosen_file = found[int(sel) - 1]
        source_path = os.path.join(resolved_path, chosen_file)
    else:
        source_path = resolved_path

    if not source_path.lower().endswith(".gguf"):
        print(f"{C_YELLOW}[!] Warning: '{os.path.basename(source_path)}' does not have a .gguf extension.{C_RESET}")
        proceed = input("Proceed anyway? (y/N): ").strip().lower()
        if proceed != "y":
            return

    filename = os.path.basename(source_path)
    file_size = os.path.getsize(source_path)
    dest_path = os.path.join(MODELS_DIR, filename)

    print(f"\nTarget File : {C_GREEN}{filename}{C_RESET} ({format_bytes(file_size)})")
    print(f"Models Dir  : {C_CYAN}{MODELS_DIR}{C_RESET}")

    if os.path.abspath(source_path) == os.path.abspath(dest_path):
        print(f"\n{C_YELLOW}[*] File is already in the Wola models directory.{C_RESET}")
    else:
        print(f"\n{C_CYAN}-----------------------------------------------------------------{C_RESET}")
        print(f"How would you like to bring this model into Wola's models directory?")
        print(f"  {C_BOLD}[1] Move{C_RESET} file into {MODELS_DIR} (Saves storage space)")
        print(f"  {C_BOLD}[2] Copy{C_RESET} file into {MODELS_DIR} (Preserves original file)")
        print(f"  {C_BOLD}[0]{C_RESET} Cancel")
        print(f"{C_CYAN}-----------------------------------------------------------------{C_RESET}")
        action = input(f"{C_BOLD}Select choice [1=Move / 2=Copy / 0=Cancel]: {C_RESET}").strip().lower()

        if action in ["1", "m", "move"]:
            print(f"[*] Moving {filename}...")
            shutil.move(source_path, dest_path)
            print(f"{C_GREEN}[+] Moved '{filename}' to {MODELS_DIR}{C_RESET}")
        elif action in ["2", "c", "copy"]:
            free_space = shutil.disk_usage(MODELS_DIR).free
            if file_size > free_space:
                print(f"{C_RED}[-] Not enough disk space to copy (Needs {format_bytes(file_size)}, Free: {format_bytes(free_space)}){C_RESET}")
                return
            copy_with_progress(source_path, dest_path)
            print(f"{C_GREEN}[+] Copied '{filename}' to {MODELS_DIR}{C_RESET}")
        else:
            print("Import cancelled.")
            return

    # Role assignment prompt
    print(f"\n{C_CYAN}-----------------------------------------------------------------{C_RESET}")
    print(f"Assign '{filename}' role in ~/.wolarc:")
    print(f"  [c] Set as Active Chat LLM (wola.m chat {filename})")
    print(f"  [e] Set as Active Embedding Model (wola.m embed {filename})")
    print(f"  [n] None / Don't activate right now")
    print(f"{C_CYAN}-----------------------------------------------------------------{C_RESET}")
    role = input(f"{C_BOLD}Assign role [c/e/n]: {C_RESET}").strip().lower()

    if role == "c":
        apply_to_config(filename, "chat", prompt_confirm=False)
    elif role == "e":
        apply_to_config(filename, "embed", prompt_confirm=False)
    else:
        print(f"{C_GREEN}[+] Model is ready in {MODELS_DIR}! Activate later with 'wola.m chat {filename}'{C_RESET}")

def quick_start_models():
    print(f"\n{C_CYAN}================================================================={C_RESET}")
    print(f"       {C_BOLD}WOLARC AUTOMATED STARTER MODEL ACQUISITION ENGINE{C_RESET}")
    print(f"{C_CYAN}================================================================={C_RESET}")

    existing_ggufs = [f for f in os.listdir(MODELS_DIR) if f.lower().endswith(".gguf")] if os.path.exists(MODELS_DIR) else []
    chat_found = None
    embed_found = None

    for g in existing_ggufs:
        glow = g.lower()
        if ("embed" in glow or "minilm" in glow or "bge" in glow or "nomic" in glow) and not embed_found:
            embed_found = g
        elif ("embed" not in glow and "minilm" not in glow and "bge" not in glow and "nomic" not in glow) and not chat_found:
            chat_found = g

    # 1. Embedding Model
    if embed_found:
        print(f"  {C_GREEN}✓ Active embedding model detected:{C_RESET} {embed_found}")
        apply_to_config(embed_found, "embed", prompt_confirm=False)
    else:
        starter_embed = CURATED_EMBED[0]  # All-MiniLM-L6-v2 (45 MB)
        print(f"\n  [*] Downloading starter embedding model: {starter_embed['name']} ({starter_embed['size']})...")
        embed_url = f"https://huggingface.co/{starter_embed['repo']}/resolve/main/{starter_embed['file']}"
        dest = download_file(embed_url, starter_embed['file'], non_interactive=True)
        if dest and os.path.exists(dest):
            apply_to_config(starter_embed['file'], "embed", prompt_confirm=False)
            embed_found = starter_embed['file']
        else:
            print(f"  {C_RED}[-] Failed to download embedding model.{C_RESET}")

    # 2. Chat Model
    if chat_found:
        print(f"  {C_GREEN}✓ Active chat model detected:{C_RESET} {chat_found}")
        apply_to_config(chat_found, "chat", prompt_confirm=False)
    else:
        tot_ram, avail_ram = get_ram_info()
        starter_chat = CURATED_CHAT[1]  # Llama 3.2 1B
        if 0 < avail_ram < 2000:
            starter_chat = CURATED_CHAT[2]  # Qwen 2.5 0.5B

        print(f"\n  [*] Downloading starter chat model: {starter_chat['name']} ({starter_chat['size']})...")
        chat_url = f"https://huggingface.co/{starter_chat['repo']}/resolve/main/{starter_chat['file']}"
        dest = download_file(chat_url, starter_chat['file'], non_interactive=True)
        if dest and os.path.exists(dest):
            apply_to_config(starter_chat['file'], "chat", prompt_confirm=False)
            chat_found = starter_chat['file']
        else:
            print(f"  {C_RED}[-] Failed to download chat model.{C_RESET}")

    if embed_found and chat_found:
        print(f"\n{C_CYAN}================================================================={C_RESET}")
        print(f"  {C_GREEN}✓ STARTER MODELS CONFIGURED SUCCESSFULLY!{C_RESET}")
        print(f"    • Chat LLM  : {chat_found}")
        print(f"    • Embed LLM : {embed_found}")
        print(f"  Run '{C_BOLD}wola.r{C_RESET}' or '{C_BOLD}wola{C_RESET}' to start inference services.")
        print(f"{C_CYAN}================================================================={C_RESET}\n")
        return True
    return False

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ["--quick-start", "-quick-start", "quick-start", "--starter", "starter"]:
            success = quick_start_models()
            sys.exit(0 if success else 1)
        elif arg in ["import", "add"] and len(sys.argv) > 2:
            menu_import_local(sys.argv[2])
            return
        elif os.path.exists(os.path.expanduser(sys.argv[1])):
            menu_import_local(sys.argv[1])
            return

    while True:
        sys.stdout.write("\033[2J\033[H")
        free_gb = shutil.disk_usage(MODELS_DIR).free // (1024**3)
        total_ram, avail_ram = get_ram_info()
        print(f"{C_MAGENTA}================================================================={C_RESET}")
        print(f"                  {C_BOLD}WOLA MODEL STORE (wola.gt){C_RESET}")
        print(f"{C_MAGENTA}================================================================={C_RESET}")
        print(f"  Storage Free  : {C_GREEN}{free_gb} GB{C_RESET}")
        print(f"  RAM Available : {C_CYAN}{avail_ram} MB / {total_ram} MB{C_RESET}")
        print("-----------------------------------------------------------------")
        print(f"  {C_BOLD}[1]{C_RESET} {C_GREEN}Live Hugging Face Search{C_RESET} (Fast tree + file sizes)")
        print(f"  {C_BOLD}[2]{C_RESET} Curated Chat LLMs (Gemma, Qwen, Llama, Phi)")
        print(f"  {C_BOLD}[3]{C_RESET} Curated Embedding Models (BGE, Nomic, Gemma-Embed)")
        print(f"  {C_BOLD}[4]{C_RESET} Enter HF Repo Manually (e.g. bartowski/Qwen2.5-1.5B-Instruct-GGUF)")
        print(f"  {C_BOLD}[5]{C_RESET} {C_YELLOW}Import Local GGUF Model{C_RESET} (From custom directory/storage)")
        print(f"  {C_BOLD}[6]{C_RESET} {C_RED}Delete Models{C_RESET} (Free up disk space)")
        print(f"  {C_BOLD}[0]{C_RESET} Exit")
        print("=================================================================")

        ans = input(f"{C_BOLD}Select option: {C_RESET}").strip()
        if ans == "1":
            search_huggingface()
        elif ans == "2":
            menu_curated(CURATED_CHAT, "chat")
        elif ans == "3":
            menu_curated(CURATED_EMBED, "embed")
        elif ans == "4":
            repo = input("Enter repo (owner/model): ").strip()
            if repo and "/" in repo:
                inspect_repo_and_download(repo)
        elif ans == "5":
            menu_import_local()
        elif ans == "6":
            menu_delete()
        elif ans == "0":
            break
        else:
            continue
        input(f"\n{C_BOLD}Press Enter to return to menu...{C_RESET}")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nStore closed.")
