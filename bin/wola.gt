#!/data/data/com.termux/files/usr/bin/python3
import os, sys, requests, json, time, shutil, re
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry

CONFIG_FILE = os.path.expanduser("~/.wolarc")
MODELS_DIR = os.path.expanduser("~/models")

if os.path.exists(CONFIG_FILE):
    try:
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                if line.startswith("MODELS_DIR="):
                    MODELS_DIR = os.path.expanduser(line.split("=", 1)[1].strip("\"' \n"))
    except Exception:
        pass

os.makedirs(MODELS_DIR, exist_ok=True)

C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_RED = "\033[1;31m"
C_GREEN = "\033[1;32m"
C_YELLOW = "\033[1;33m"
C_CYAN = "\033[1;36m"
C_MAGENTA = "\033[1;35m"
C_DIM = "\033[2m"

EMBED_KEYWORDS = [
    "embed", "bge", "nomic", "minilm", "e5", "gte", 
    "sentence-transformers", "bert", "arctic", "snowflake"
]
EMBED_PIPELINES = ["sentence-similarity", "feature-extraction"]

