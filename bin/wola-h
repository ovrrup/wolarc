#!/data/data/com.termux/files/usr/bin/bash

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"

CONFIG="$HOME/.wolarc"
LOCK="$HOME/.wola.lock"
[ -f "$CONFIG" ] && source "$CONFIG"

is_online() {
    [ -f "$LOCK" ] || pgrep -f "agent.py" >/dev/null 2>&1
}

get_tunnel() {
    local url_file="$HOME/.wola_url"
    if [ -f "$url_file" ]; then
        cat "$url_file" | tr -d ' \n\r'
        return
    fi
    local t_log="$HOME/tunnel.log"
    if [ -f "$t_log" ]; then
        grep -oE "https://[a-zA-Z0-9.-]+(?:\.lhr\.life|\.serveo\.net|\.pinggy\.link|\.free\.pinggy\.link)" "$t_log" 2>/dev/null | grep -v "admin" | tail -n 1
    fi
}

show_manual() {
    clear 2>/dev/null || true
    local state_badge="${C_RED}○ STOPPED${C_RESET}"
    if is_online; then
        state_badge="${C_GREEN}● RUNNING${C_RESET}"
    fi

    local tunnel=$(get_tunnel)
    [ -z "$tunnel" ] && tunnel="Not active"

    # Check update cache
    local update_badge=""
    if [ -f "$HOME/.wola_update_cache.json" ]; then
        if grep -q '"update_available": true' "$HOME/.wola_update_cache.json" 2>/dev/null; then
            update_badge="  ${C_YELLOW}⚡ Update available! Run 'wola.u' to upgrade.${C_RESET}\n"
        fi
    fi

    echo -e "${C_CYAN}╭────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_CYAN}│${C_RESET}             ${C_BOLD}WOLARC AUTONOMOUS AI NODE - COMMAND CENTER${C_RESET}         ${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "  Status: $state_badge   ${C_DIM}•${C_RESET}   Gateway: ${C_GREEN}${tunnel}${C_RESET}"
    [ -n "$update_badge" ] && echo -e "$update_badge"
    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e " ${C_BOLD}COMMAND PAIRS (Casual / Technical)${C_RESET}"
    echo -e "   ${C_GREEN}wola.start${C_RESET}     / ${C_DIM}wola.r${C_RESET}        Start all services (Chat, Embed, API, Tunnel)"
    echo -e "   ${C_RED}wola.stop${C_RESET}      / ${C_DIM}wola.k${C_RESET}        Stop all services cleanly"
    echo -e "   ${C_YELLOW}wola.restart${C_RESET}   / ${C_DIM}wola.rs${C_RESET}       Restart all background services"
    echo -e "   ${C_CYAN}wola.check${C_RESET}     / ${C_DIM}wola.status${C_RESET}   Inspect service PIDs, RAM & port telemetry"
    echo -e "   ${C_CYAN}wola.dashboard${C_RESET} / ${C_DIM}wola.d${C_RESET}        Live telemetry dashboard & metrics"
    echo -e "   ${C_GREEN}wola.chat${C_RESET}      / ${C_DIM}wola.c${C_RESET}        Interactive RAG chat client (/think, citations)"
    echo -e "   ${C_YELLOW}wola.models${C_RESET}    / ${C_DIM}wola.m${C_RESET}        Local model manager & GGUF switcher"
    echo -e "   ${C_GREEN}wola.store${C_RESET}     / ${C_DIM}wola.gt${C_RESET}       In-terminal Model Store & downloader"
    echo -e "   ${C_YELLOW}wola.knowledge${C_RESET} / ${C_DIM}wola.i${C_RESET}        Vector knowledge base & document indexer"
    echo -e "   ${C_YELLOW}wola.bench${C_RESET}     / ${C_DIM}wola.b${C_RESET}        Hardware benchmark & token velocity test"
    echo -e "   ${C_DIM}wola.log${C_RESET}       / ${C_DIM}wola.l${C_RESET}        Multi-stream daemon log monitor"
    echo -e "   ${C_MAGENTA}wola.think${C_RESET}     / ${C_DIM}wola.th${C_RESET}       Live reasoning stream (<think> viewer & toggle)"
    echo -e "   ${C_CYAN}wola.link${C_RESET}      / ${C_DIM}wola.url${C_RESET}      Public Gateway URL, latency & QR code"
    echo -e "   ${C_CYAN}wola.hotspot${C_RESET}   / ${C_DIM}wola.local${C_RESET}    Air-Gapped Hotspot & LAN Web UI (Offline)"
    echo -e "   ${C_YELLOW}wola.config${C_RESET}    / ${C_DIM}wola.t${C_RESET}        Inspect and adjust ~/.wolarc parameters"
    echo -e "   ${C_GREEN}wola.update${C_RESET}    / ${C_DIM}wola.u${C_RESET}        Check for updates and apply latest release"
    echo -e "   ${C_RED}wola.uninstall${C_RESET} / ${C_DIM}wola.purge${C_RESET}    Clean system reset and uninstaller"
    echo -e "   ${C_CYAN}wola.help${C_RESET}      / ${C_DIM}wola.h${C_RESET}        Display this guide & command cheatsheet"
    echo -e "   ${C_CYAN}wola.ui${C_RESET}        / ${C_DIM}wola.tui${C_RESET}      Toggle Go Bubble Tea TUI vs classic CLI"
    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
}

interactive_menu() {
    while true; do
        show_manual
        echo -e " ${C_BOLD}QUICK LAUNCH SHORTCUTS:${C_RESET}"
        echo -e "  [1] Start (wola.start)      [5] Remote Link (wola.link)   [9]  Benchmark (wola.bench)"
        echo -e "  [2] Stop (wola.stop)        [6] CLI Chat (wola.chat)      [10] View Logs (wola.log)"
        echo -e "  [3] Restart (wola.restart)  [7] Think Stream (wola.think) [11] Model Store (wola.store)"
        echo -e "  [4] Dashboard (wola.dash)   [8] Knowledge (wola.knowledge)[12] Local Hotspot (wola.hotspot)"
        echo -e "  [u] Update (wola.update)    [p] Reset / Uninstall         [t]  Toggle TUI Mode"
        echo -e "  [0] Exit Menu"
        echo ""
        read -p "Select option (or press Enter to exit): " choice
        case "$choice" in
            1) wola.r; read -p "Press Enter to continue..." ;;
            2) wola.k; read -p "Press Enter to continue..." ;;
            3) wola.rs; read -p "Press Enter to continue..." ;;
            4) wola.d ;;
            5) wola.url; read -p "Press Enter to continue..." ;;
            6) wola.chat ;;
            7) wola.th ;;
            8) 
                read -p "Enter test query for knowledge base: " q_text
                [ -n "$q_text" ] && wola.i search "$q_text"
                read -p "Press Enter to continue..."
                ;;
            9) wola.bench; read -p "Press Enter to continue..." ;;
            10) wola.log; read -p "Press Enter to continue..." ;;
            11) wola.gt ;;
            12) wola.url local; read -p "Press Enter to continue..." ;;
            "u"|"U") wola.u; read -p "Press Enter to continue..." ;;
            "p"|"P") wola.purge; read -p "Press Enter to continue..." ;;
            "t"|"T") 
                if [ "${ENABLE_TUI:-true}" = "false" ]; then
                    wolarc tui on
                else
                    wolarc tui off
                fi
                [ -f "$CONFIG" ] && source "$CONFIG"
                read -p "Press Enter to continue..."
                ;;
            0|"") break ;;
            *) echo "Invalid option." ; sleep 1 ;;
        esac
    done
}

if [ "$1" == "--help" ] || [ "$1" == "-h" ] || [ ! -t 0 ]; then
    show_manual
else
    interactive_menu
fi
