#!/data/data/com.termux/files/usr/bin/bash

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"

CONFIG="$HOME/.wolarc"
LOCK="$HOME/.wola.lock"
[ -f "$CONFIG" ] && source "$CONFIG"

is_online() {
    [ -f "$LOCK" ] || pgrep -f "agent.py" >/dev/null 2>&1
}

get_tunnel() {
    local url_file="$HOME/.wola_url"
    if [ -f "$url_file" ]; then
        cat "$url_file" | tr -d ' \n\r'
        return
    fi
    local t_log="$HOME/tunnel.log"
    if [ -f "$t_log" ]; then
        grep -oE "https://[a-zA-Z0-9.-]+(?:\.lhr\.life|\.serveo\.net|\.pinggy\.link|\.free\.pinggy\.link)" "$t_log" 2>/dev/null | grep -v "admin" | tail -n 1
    fi
}

show_manual() {
    clear 2>/dev/null || true
    local state_badge="${C_RED}○ STOPPED${C_RESET}"
    if is_online; then
        state_badge="${C_GREEN}● RUNNING${C_RESET}"
    fi

    local tunnel=$(get_tunnel)
    [ -z "$tunnel" ] && tunnel="Not active"

    # Check update cache
    local update_badge=""
    if [ -f "$HOME/.wola_update_cache.json" ]; then
        if grep -q '"update_available": true' "$HOME/.wola_update_cache.json" 2>/dev/null; then
            update_badge="  ${C_YELLOW}⚡ Update available! Run 'wola.u' to upgrade.${C_RESET}\n"
        fi
    fi

    echo -e "${C_CYAN}╭────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_CYAN}│${C_RESET}             ${C_BOLD}WOLARC AUTONOMOUS AI NODE - COMMAND CENTER${C_RESET}         ${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "  Status: $state_badge   ${C_DIM}•${C_RESET}   Gateway: ${C_GREEN}${tunnel}${C_RESET}"
    [ -n "$update_badge" ] && echo -e "$update_badge"
    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e " ${C_BOLD}1. SYSTEM LIFECYCLE${C_RESET}"
    echo -e "   ${C_GREEN}wola.r${C_RESET}             Start all services (Embedding, Chat, API, Tunnel)"
    echo -e "   ${C_RED}wola.k${C_RESET}             Stop all processes cleanly and release wake-lock"
    echo -e "   ${C_YELLOW}wola.rs${C_RESET}            Restart all services (clean shutdown -> boot)"
    echo -e "   ${C_CYAN}wolarc status${C_RESET}      Inspect process PIDs and listening ports"
    echo ""
    echo -e " ${C_BOLD}2. CONNECTIVITY & CHAT CLIENT${C_RESET}"
    echo -e "   ${C_CYAN}wola.url${C_RESET}           Tunnel URL, ping latency, QR code & clipboard"
    echo -e "   ${C_CYAN}wola.local${C_RESET}         Air-Gapped Hotspot & LAN Web Chat UI (Offline)"
    echo -e "   ${C_GREEN}wola.chat${C_RESET}          Interactive CLI chat with note citations"
    echo ""
    echo -e " ${C_BOLD}3. LIVE MONITORING & TELEMETRY${C_RESET}"
    echo -e "   ${C_CYAN}wola.d${C_RESET}             Telemetry Dashboard (Tokens/sec, RAM, Health)"
    echo -e "   ${C_MAGENTA}wola.th${C_RESET}            Thinking Stream Viewer (Live <think> tokens)"
    echo -e "   ${C_DIM}wola.log${C_RESET}           Unified daemon log monitor (chat/embed/tunnel)"
    echo ""
    echo -e " ${C_BOLD}4. MODELS & VECTOR KNOWLEDGE BASE${C_RESET}"
    echo -e "   ${C_GREEN}wola.gt${C_RESET} (wola.gh)   Model Store & Local GGUF Importer (HF / Storage)"
    echo -e "   ${C_YELLOW}wola.m${C_RESET}             List local models in ~/models (or 'wola.m import <path>')"
    echo -e "   ${C_YELLOW}wola.i status${C_RESET}      Inspect indexed documents and chunk statistics"
    echo -e "   ${C_YELLOW}wola.i add <f>${C_RESET}     Import document/folder and index immediately"
    echo -e "   ${C_YELLOW}wola.i search <q>${C_RESET}  Test vector similarity retrieval directly"
    echo ""
    echo -e " ${C_BOLD}5. TUNING & BENCHMARKING${C_RESET}"
    echo -e "   ${C_YELLOW}wola.bench${C_RESET}         Measure token speed & auto-tune CPU threads"
    echo -e "   ${C_YELLOW}wola.t${C_RESET}             View/edit parameters (TEMPERATURE, TOP_K, etc.)"
    echo -e "   ${C_YELLOW}wola tui [on|off]${C_RESET}  Toggle Go Bubble Tea TUI vs classic CLI suite"
    echo ""
    echo -e " ${C_BOLD}6. UPDATES & MAINTENANCE${C_RESET}"
    echo -e "   ${C_GREEN}wola.u${C_RESET}             Check for updates and apply latest release"
    echo -e "   ${C_RED}wola.purge${C_RESET}         Discrete file deletion and system purge"
    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
}

interactive_menu() {
    while true; do
        show_manual
        echo -e " ${C_BOLD}QUICK LAUNCH SHORTCUTS:${C_RESET}"
        echo -e "  [1] Start (wola.r)          [5] Remote URL (wola.url)   [9]  Benchmark (wola.bench)"
        echo -e "  [2] Stop (wola.k)           [6] CLI Chat (wola.chat)    [10] View Logs (wola.log)"
        echo -e "  [3] Restart (wola.rs)       [7] Think Stream (wola.th)  [11] Model Store (wola.gt/gh)"
        echo -e "  [4] Dashboard (wola.d)      [8] RAG Search (wola.i)     [12] Local Gateway (wola.local)"
        echo -e "  [u] Check Updates (wola.u)  [p] Purge / Clean           [t]  Toggle TUI Mode"
        echo -e "  [0] Exit Menu"
        echo ""
        read -p "Select option (or press Enter to exit): " choice
        case "$choice" in
            1) wola.r; read -p "Press Enter to continue..." ;;
            2) wola.k; read -p "Press Enter to continue..." ;;
            3) wola.rs; read -p "Press Enter to continue..." ;;
            4) wola.d ;;
            5) wola.url; read -p "Press Enter to continue..." ;;
            6) wola.chat ;;
            7) wola.th ;;
            8) 
                read -p "Enter test query for knowledge base: " q_text
                [ -n "$q_text" ] && wola.i search "$q_text"
                read -p "Press Enter to continue..."
                ;;
            9) wola.bench; read -p "Press Enter to continue..." ;;
            10) wola.log; read -p "Press Enter to continue..." ;;
            11) wola.gt ;;
            12) wola.url local; read -p "Press Enter to continue..." ;;
            "u"|"U") wola.u; read -p "Press Enter to continue..." ;;
            "p"|"P") wola.purge; read -p "Press Enter to continue..." ;;
            "t"|"T") 
                if [ "${ENABLE_TUI:-true}" = "false" ]; then
                    wolarc tui on
                else
                    wolarc tui off
                fi
                [ -f "$CONFIG" ] && source "$CONFIG"
                read -p "Press Enter to continue..."
                ;;
            0|"") break ;;
            *) echo "Invalid option." ; sleep 1 ;;
        esac
    done
}

if [ "$1" == "--help" ] || [ "$1" == "-h" ] || [ ! -t 0 ]; then
    show_manual
else
    interactive_menu
fi
