#!/data/data/com.termux/files/usr/bin/bash

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"

clear
echo -e "${C_CYAN}=================================================================${C_RESET}"
echo -e "                   ${C_BOLD}WOLA AI AGENT - COMMAND CENTER${C_RESET}"
echo -e "${C_CYAN}=================================================================${C_RESET}"
echo -e "  Wola transforms your Android device into a private, autonomous"
echo -e "  RAG AI server with persistent remote access."
echo ""
echo -e "${C_BOLD}1. CORE SWITCH CONTROLS${C_RESET}"
echo -e "  ${C_GREEN}wola.r${C_RESET}             Start all services (Embedding, Chat, API, Tunnel)"
echo -e "                     • Protected switch: prevents redundant launches"
echo -e "                     • Acquires wake-lock to prevent OS sleeping"
echo -e "  ${C_RED}wola.k${C_RESET}             Stop all processes cleanly and release wake-lock"
echo -e "  ${C_YELLOW}wola.rs${C_RESET}            Restart all services (clean cycle wola.k -> wola.r)"
echo -e "  ${C_YELLOW}wolarc status${C_RESET}      Check live PID states and active ports"
echo ""
echo -e "${C_BOLD}2. LIVE MONITORING & TELEMETRY${C_RESET}"
echo -e "  ${C_MAGENTA}wola.th${C_RESET}            ${C_BOLD}Thinking Stream Viewer${C_RESET}"
echo -e "                     • Watch the model's inner thoughts in real time"
echo -e "                     • Highlights <think> reasoning blocks & RAG scores"
echo -e "  ${C_CYAN}wola.d${C_RESET}             ${C_BOLD}Telemetry Dashboard${C_RESET}"
echo -e "                     • Live tokens/sec, prompt eval speed, token counts"
echo -e "                     • Live public Base URL and service health check"
echo ""
echo -e "${C_BOLD}3. TUNING & HARDWARE CONFIGURATION${C_RESET}"
echo -e "  ${C_YELLOW}wola.t${C_RESET}             View all active configuration parameters"
echo -e "  ${C_YELLOW}wola.t <K> <V>${C_RESET}     Tweak any parameter without editing files"
echo -e "  ${C_BOLD}Instant Live Knobs (No restart required):${C_RESET}"
echo -e "    wola.t TEMPERATURE 0.2          Lower randomness (more deterministic)"
echo -e "    wola.t SIMILARITY_THRESHOLD 0.70 Require closer match for notes"
echo -e "    wola.t TOP_K 3                  Inject up to 3 note chunks"
echo -e "    wola.t SYSTEM_PROMPT \"...\"       Modify assistant personality"
echo -e "  ${C_BOLD}Engine Knobs (Apply on next wola.r start):${C_RESET}"
echo -e "    wola.t CHAT_THREADS 6           Allocate more CPU cores to Chat"
echo -e "    wola.t CHAT_CTX 2048            Decrease context size to save RAM"
echo ""
echo -e "${C_BOLD}4. MODELS & KNOWLEDGE BASE${C_RESET}"
echo -e "  ${C_GREEN}wola.gt${C_RESET}            Model Store (Download from HF/Curated with embed security verification)"
echo -e "  ${C_YELLOW}wola.m${C_RESET}             List all available GGUF models in ~/models"
echo -e "  ${C_YELLOW}wola.m chat <f>${C_RESET}    Select chat model file"
echo -e "  ${C_YELLOW}wola.m embed <f>${C_RESET}   Select embedding model file"
echo -e "  ${C_YELLOW}wola.i status${C_RESET}      Inspect indexed documents and chunk statistics"
echo -e "  ${C_YELLOW}wola.i sync${C_RESET}        Trigger an immediate notes scan"
echo -e "  ${C_YELLOW}wola.i rebuild${C_RESET}     Purge database and re-vectorize from scratch"
echo ""
echo -e "${C_BOLD}5. CONNECTING CLIENT APPS (Primary Phone / PC)${C_RESET}"
echo -e "  In your chat app (Chatbox, Obsidian, NextChat, etc.):"
echo -e "  • Base URL : ${C_GREEN}https://<your-subdomain>.lhr.life/v1${C_RESET} (or /chat/completions)"
echo -e "  • API Key  : ${C_GREEN}sk-test${C_RESET} (or anything non-empty)"
echo -e "  • Model    : Auto-detected by client (or type your active model name)"
echo -e "${C_CYAN}=================================================================${C_RESET}"
echo -e "  Run ${C_BOLD}wola-h${C_RESET} anytime to revisit this manual."
