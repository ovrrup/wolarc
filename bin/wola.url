#!/data/data/com.termux/files/usr/bin/bash

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"

URL_FILE="$HOME/.wola_url"
PROVIDER_FILE="$HOME/.wola_provider"
CONFIG="$HOME/.wolarc"
[ -f "$CONFIG" ] && source "$CONFIG"

get_url() {
    if [ -f "$URL_FILE" ]; then
        cat "$URL_FILE" | tr -d ' \n\r'
    elif [ -f "$HOME/tunnel.log" ]; then
        grep -oE "https://[a-zA-Z0-9.-]+(?:\.lhr\.life|\.serveo\.net|\.pinggy\.link|\.free\.pinggy\.link)" "$HOME/tunnel.log" 2>/dev/null | grep -v "admin" | tail -n 1
    fi
}

get_provider() {
    if [ -f "$PROVIDER_FILE" ]; then
        cat "$PROVIDER_FILE" | tr -d ' \n\r'
    else
        echo "Auto-detected"
    fi
}

copy_clipboard() {
    local url="$1"
    if command -v termux-clipboard-set >/dev/null 2>&1; then
        echo -n "$url" | termux-clipboard-set
        echo -e "  ${C_GREEN}✓ Copied URL to Android clipboard!${C_RESET}"
    elif command -v xclip >/dev/null 2>&1; then
        echo -n "$url" | xclip -selection clipboard
        echo -e "  ${C_GREEN}✓ Copied URL to clipboard!${C_RESET}"
    elif command -v wl-copy >/dev/null 2>&1; then
        echo -n "$url" | wl-copy
        echo -e "  ${C_GREEN}✓ Copied URL to clipboard!${C_RESET}"
    fi
}

ping_test() {
    local url="$1"
    if [ -z "$url" ]; then
        return
    fi
    echo -n -e "  • Tunnel Latency : "
    local start_ms=$(python3 -c "import time; print(int(time.time()*1000))")
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" -m 6 "${url}/health" 2>/dev/null)
    local end_ms=$(python3 -c "import time; print(int(time.time()*1000))")
    local diff=$((end_ms - start_ms))

    if [ "$http_code" = "200" ]; then
        echo -e "${C_GREEN}200 OK (${diff}ms)${C_RESET}"
    else
        echo -e "${C_YELLOW}HTTP ${http_code} (${diff}ms)${C_RESET}"
    fi
}

show_qr() {
    local url="$1"
    if [ -z "$url" ]; then
        return
    fi
    echo -e "\n  ${C_BOLD}Scan QR code to connect from phone/PC/tablet:${C_RESET}"
    local rendered=false
    if python3 -c "import qrcode" >/dev/null 2>&1; then
        local qr_ascii
        qr_ascii=$(python3 -c "
import sys, qrcode, io
buf = io.StringIO()
qr = qrcode.QRCode(border=1)
qr.add_data(sys.argv[1])
qr.print_ascii(out=buf, invert=True)
for line in buf.getvalue().splitlines():
    print('    ' + line)
" "$url" 2>/dev/null)
        if [ -n "$qr_ascii" ]; then
            echo "$qr_ascii"
            rendered=true
        fi
    fi
    if [ "$rendered" = false ]; then
        local qr_res
        qr_res=$(curl -s -m 3 "https://qrenco.de/${url}" 2>/dev/null)
        if [ -n "$qr_res" ] && [[ "$qr_res" =~ "█" ]]; then
            echo "$qr_res" | head -n 22 | sed 's/^/  /'
        else
            echo -e "  ${C_DIM}(Offline mode: navigate directly to ${url})${C_RESET}"
        fi
    fi
}

get_local_net_json() {
    local port="${AGENT_PORT:-5000}"
    python3 -c "
import subprocess, re, socket, json
interfaces = []
seen = set()
port = '${port}'
for cmd in [['ifconfig'], ['ip', '-4', 'addr']]:
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode()
        cur_iface = ''
        for line in out.splitlines():
            if line and not line.startswith(' '):
                cur_iface = line.split(':')[0].split()[0].strip()
            m = re.search(r'inet\s+(\d+\.\d+\.\d+\.\d+)', line)
            if m:
                ip = m.group(1)
                if ip != '127.0.0.1' and not ip.startswith('169.254.') and ip not in seen:
                    seen.add(ip)
                    label = 'Local Wi-Fi / LAN'
                    if 'ap' in cur_iface or 'swlan' in cur_iface or ip.startswith('192.168.43.'):
                        label = 'Android Mobile Hotspot'
                    elif 'rndis' in cur_iface or 'usb' in cur_iface or ip.startswith('192.168.42.'):
                        label = 'USB Tethering'
                    interfaces.append({'iface': cur_iface or 'net', 'ip': ip, 'label': label, 'url': f'http://{ip}:{port}'})
        if interfaces:
            break
    except Exception:
        pass

for probe in ['8.8.8.8', '192.168.43.254', '192.168.1.1']:
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect((probe, 80))
        ip = s.getsockname()[0]
        s.close()
        if ip and ip != '127.0.0.1' and ip not in seen:
            seen.add(ip)
            interfaces.append({'iface': 'sock', 'ip': ip, 'label': 'Local Wi-Fi / LAN', 'url': f'http://{ip}:{port}'})
    except Exception:
        pass

if '192.168.43.1' not in seen:
    interfaces.append({'iface': 'hotspot', 'ip': '192.168.43.1', 'label': 'Android Mobile Hotspot (Gateway)', 'url': f'http://192.168.43.1:{port}'})

print(json.dumps(interfaces))
" 2>/dev/null
}

show_local_gateway() {
    local port="${AGENT_PORT:-5000}"
    echo -e "${C_CYAN}╭────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_CYAN}│${C_RESET}             ${C_BOLD}WOLARC AIR-GAPPED LOCAL OFFLINE GATEWAY${C_RESET}            ${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰────────────────────────────────────────────────────────────────╯${C_RESET}"

    local net_json
    net_json=$(get_local_net_json)

    local primary_local_url="http://192.168.43.1:${port}"
    if [ -n "$net_json" ]; then
        python3 -c "
import json
data = json.loads('''$net_json''')
for item in data:
    lbl = item.get('label', 'Local')
    url = item.get('url', '')
    print(f\"  • {lbl:<32} : \033[1;32m{url}\033[0m\")
"
        primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${port}')")
    else
        echo -e "  • Android Mobile Hotspot (Gateway): ${C_GREEN}http://192.168.43.1:${port}${C_RESET}"
    fi

    echo -e "  • Web Chat & Pairing UI           : ${C_GREEN}${primary_local_url}/${C_RESET}"
    echo -e "  • OpenAI Compatible Base URL      : ${C_CYAN}${primary_local_url}/v1${C_RESET}"
    echo -e "  • API Key (Header)                : ${C_YELLOW}sk-test${C_RESET}"
    echo -e "  • Model ID                        : ${C_DIM}local-agent${C_RESET}"
    copy_clipboard "$primary_local_url"

    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
    show_qr "$primary_local_url"
    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}HOW TO CONNECT WITHOUT INTERNET OR WI-FI ROUTER:${C_RESET}"
    echo -e "    1. On this Android device: Turn ${C_GREEN}${C_BOLD}ON${C_RESET} Personal / Mobile Hotspot."
    echo -e "    2. On your other device (laptop, tablet, phone): Connect to Hotspot Wi-Fi."
    echo -e "    3. In any browser open: ${C_GREEN}${C_BOLD}http://192.168.43.1:${port}${C_RESET} (or scan QR code above)."
    echo -e "    4. Enjoy 100% offline chat and RAG knowledge search!"
    echo -e "${C_CYAN}=================================================================${C_RESET}"
}

switch_provider() {
    local target="$1"
    local port="${AGENT_PORT:-5000}"
    echo -e "${C_CYAN}[*] Re-negotiating tunnel connection...${C_RESET}"
    pkill -9 -f "ssh.*localhost.run" 2>/dev/null
    pkill -9 -f "ssh.*serveo.net" 2>/dev/null
    pkill -9 -f "ssh.*pinggy" 2>/dev/null
    rm -f "$HOME/tunnel.log" "$URL_FILE"

    case "$target" in
        "serveo")
            nohup ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o IPQoS=lowdelay -o Compression=no -o ExitOnForwardFailure=yes -R 80:localhost:${port} serveo.net > "$HOME/tunnel.log" 2>&1 &
            echo "serveo" > "$PROVIDER_FILE"
            ;;
        "pinggy")
            nohup ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o IPQoS=lowdelay -o Compression=no -o ExitOnForwardFailure=yes -R 0:localhost:${port} a.pinggy.io > "$HOME/tunnel.log" 2>&1 &
            echo "pinggy" > "$PROVIDER_FILE"
            ;;
        *)
            nohup ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=10 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o IPQoS=lowdelay -o Compression=no -o ExitOnForwardFailure=yes -R 80:localhost:${port} nokey@localhost.run > "$HOME/tunnel.log" 2>&1 &
            echo "localhost.run" > "$PROVIDER_FILE"
            ;;
    esac

    echo -n "[*] Connecting "
    local new_url=""
    for i in {1..15}; do
        new_url=$(grep -oE "https://[a-zA-Z0-9.-]+(?:\.lhr\.life|\.serveo\.net|\.pinggy\.link|\.free\.pinggy\.link)" "$HOME/tunnel.log" 2>/dev/null | grep -v "admin" | tail -n 1)
        [ -n "$new_url" ] && break
        echo -n "."
        sleep 1
    done
    echo ""

    if [ -n "$new_url" ]; then
        echo "$new_url" > "$URL_FILE"
        echo "${new_url}/v1" > "$HOME/.wola_endpoint"
        echo -e "${C_GREEN}[+] Tunnel established: ${new_url}${C_RESET}"
        copy_clipboard "$new_url"
    else
        echo -e "${C_RED}[-] Failed to establish tunnel with ${target}.${C_RESET}"
        echo "    Inspect details with: cat ~/tunnel.log"
    fi
}

# Main flow
URL=$(get_url)
PROVIDER=$(get_provider)
PORT="${AGENT_PORT:-5000}"

SELF_NAME=$(basename "$0")
if [ "$SELF_NAME" = "wola.local" ] || [ "$SELF_NAME" = "wola.hotspot" ]; then
    case "$1" in
        "copy")
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            copy_clipboard "$primary_local_url"
            exit 0
            ;;
        "raw")
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            echo "$primary_local_url"
            exit 0
            ;;
        "api"|"endpoint")
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            echo "${primary_local_url}/v1"
            exit 0
            ;;
        "qr")
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            show_qr "$primary_local_url"
            exit 0
            ;;
        *)
            show_local_gateway
            exit 0
            ;;
    esac
fi

case "$1" in
    "local"|"offline"|"hotspot"|"lan")
        show_local_gateway
        ;;
    "local-json"|"json")
        get_local_net_json
        ;;
    "local-raw")
        net_json=$(get_local_net_json)
        primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
        echo "$primary_local_url"
        ;;
    "local-api"|"local-endpoint")
        net_json=$(get_local_net_json)
        primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
        echo "${primary_local_url}/v1"
        ;;
    "raw")
        [ -n "$URL" ] && echo "$URL" || exit 1
        ;;
    "endpoint"|"api")
        [ -n "$URL" ] && echo "${URL}/v1" || exit 1
        ;;
    "copy")
        if [ -n "$URL" ]; then
            copy_clipboard "$URL"
        else
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            copy_clipboard "$primary_local_url"
        fi
        ;;
    "switch"|"provider")
        switch_provider "$2"
        ;;
    "reconnect")
        switch_provider "$PROVIDER"
        ;;
    "qr")
        if [ -n "$2" ]; then
            show_qr "$2"
        elif [ -n "$URL" ]; then
            show_qr "$URL"
        else
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            show_qr "$primary_local_url"
        fi
        ;;
    *)
        echo -e "${C_CYAN}╭────────────────────────────────────────────────────────────────╮${C_RESET}"
        echo -e "${C_CYAN}│${C_RESET}               ${C_BOLD}WOLARC REMOTE GATEWAY & TUNNEL URL${C_RESET}               ${C_CYAN}│${C_RESET}"
        echo -e "${C_CYAN}╰────────────────────────────────────────────────────────────────╯${C_RESET}"
        if [ -z "$URL" ]; then
            echo -e "  ${C_RED}○ Remote Tunnel : OFFLINE / DISCONNECTED${C_RESET}"
            echo -e "  ${C_DIM}(Start Wola with 'wola.r' when internet is available for remote access)${C_RESET}"
            echo ""
            show_local_gateway
            exit 0
        fi

        echo -e "  • Public Base URL : ${C_GREEN}${C_BOLD}${URL}${C_RESET}"
        echo -e "  • OpenAI Endpoint : ${C_CYAN}${URL}/v1/chat/completions${C_RESET}"
        echo -e "  • API Key (Header): ${C_YELLOW}sk-test${C_RESET}"
        echo -e "  • Tunnel Provider : ${C_DIM}${PROVIDER}${C_RESET}"
        ping_test "$URL"
        copy_clipboard "$URL"
        echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
        show_qr "$URL"
        echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_BOLD}Local Offline Links (Zero Internet):${C_RESET}"
        echo -e "    • Mobile Hotspot : ${C_GREEN}http://192.168.43.1:${PORT}${C_RESET}"
        echo -e "    • View QR & LAN  : ${C_CYAN}wola local${C_RESET} or ${C_CYAN}wola.url local${C_RESET}"
        echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_BOLD}Actions:${C_RESET}"
        echo -e "    wola.url local            Show offline local link, QR & hotspot steps"
        echo -e "    wola.url copy             Copy URL to clipboard"
        echo -e "    wola.url switch serveo    Switch tunnel provider to serveo.net"
        echo -e "    wola.url switch pinggy    Switch tunnel provider to pinggy.io"
        echo -e "    wola.url reconnect        Force reconnect active tunnel"
        echo -e "${C_CYAN}=================================================================${C_RESET}"
        ;;
esac
