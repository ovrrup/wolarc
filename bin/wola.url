#!/data/data/com.termux/files/usr/bin/bash
# =================================================================
# Wolarc Connectivity & Gateway Engine
# Handles: Public Tunnels, Tailscale Mesh VPN, Local Hotspot, Wi-Fi LAN
# =================================================================

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_BLUE="\033[1;34m"

URL_FILE="$HOME/.wola_url"
PROVIDER_FILE="$HOME/.wola_provider"
ENDPOINT_FILE="$HOME/.wola_endpoint"
PID_FILE="$HOME/.wola_tunnel_daemon.pid"
CONFIG="$HOME/.wolarc"
[ -f "$CONFIG" ] && source "$CONFIG"

PORT="${AGENT_PORT:-5000}"

# -------------------------------------------------------------
# Helpers
# -------------------------------------------------------------
get_url() {
    if [ -f "$URL_FILE" ]; then
        cat "$URL_FILE" | tr -d ' \n\r'
    elif [ -f "$HOME/tunnel.log" ]; then
        grep -oE "https://[a-zA-Z0-9.-]+(?:\.trycloudflare\.com|\.lhr\.life|\.serveo\.net|\.pinggy\.link|\.free\.pinggy\.link)" "$HOME/tunnel.log" 2>/dev/null | grep -v "admin" | tail -n 1
    fi
}

get_provider() {
    if [ -f "$PROVIDER_FILE" ]; then
        cat "$PROVIDER_FILE" | tr -d ' \n\r'
    else
        echo "Auto-detected"
    fi
}

copy_clipboard() {
    local url="$1"
    if command -v termux-clipboard-set >/dev/null 2>&1; then
        echo -n "$url" | termux-clipboard-set
        echo -e "  ${C_GREEN}✓ Copied URL to Android clipboard!${C_RESET}"
    elif command -v xclip >/dev/null 2>&1; then
        echo -n "$url" | xclip -selection clipboard
        echo -e "  ${C_GREEN}✓ Copied URL to clipboard!${C_RESET}"
    elif command -v wl-copy >/dev/null 2>&1; then
        echo -n "$url" | wl-copy
        echo -e "  ${C_GREEN}✓ Copied URL to clipboard!${C_RESET}"
    else
        echo -e "  ${C_DIM}• Copy link: ${url}${C_RESET}"
    fi
}

ping_test() {
    local url="$1"
    if [ -z "$url" ]; then
        return
    fi
    echo -n -e "  • Latency Ping   : "
    local start_ms=$(python3 -c "import time; print(int(time.time()*1000))")
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" -m 6 "${url}/health" 2>/dev/null)
    local end_ms=$(python3 -c "import time; print(int(time.time()*1000))")
    local diff=$((end_ms - start_ms))

    if [ "$http_code" = "200" ] || [ "$http_code" = "204" ]; then
        echo -e "${C_GREEN}${http_code} OK (${diff}ms)${C_RESET}"
    elif [ "$http_code" = "000" ]; then
        echo -e "${C_RED}TIMEOUT / UNREACHABLE${C_RESET}"
    else
        echo -e "${C_YELLOW}HTTP ${http_code} (${diff}ms)${C_RESET}"
    fi
}

show_qr() {
    local url="$1"
    if [ -z "$url" ]; then
        return
    fi
    echo -e "\n  ${C_BOLD}Scan QR code to connect from phone/PC/tablet:${C_RESET}"
    local rendered=false
    if python3 -c "import qrcode" >/dev/null 2>&1; then
        local qr_ascii
        qr_ascii=$(python3 -c "
import sys, qrcode, io
buf = io.StringIO()
qr = qrcode.QRCode(border=1)
qr.add_data(sys.argv[1])
qr.print_ascii(out=buf, invert=True)
for line in buf.getvalue().splitlines():
    print('    ' + line)
" "$url" 2>/dev/null)
        if [ -n "$qr_ascii" ]; then
            echo "$qr_ascii"
            rendered=true
        fi
    fi
    if [ "$rendered" = false ]; then
        local qr_res
        qr_res=$(curl -s -m 3 "https://qrenco.de/${url}" 2>/dev/null)
        if [ -n "$qr_res" ] && [[ "$qr_res" =~ "█" ]]; then
            echo "$qr_res" | head -n 22 | sed 's/^/  /'
        else
            echo -e "  ${C_DIM}(Navigate directly in browser to: ${url})${C_RESET}"
        fi
    fi
}

# -------------------------------------------------------------
# Tailscale Inspection Module
# -------------------------------------------------------------
get_tailscale_json() {
    python3 -c "
import subprocess, re, json, shutil

def is_ts(ip):
    try:
        parts = [int(p) for p in ip.split('.')]
        return len(parts) == 4 and parts[0] == 100 and (64 <= parts[1] <= 127)
    except Exception:
        return False

info = {'installed': False, 'running': False, 'ip': None, 'magicdns': None, 'mode': 'none', 'self_name': None}
ts_bin = shutil.which('tailscale')
if ts_bin:
    info['installed'] = True
    try:
        out = subprocess.check_output([ts_bin, 'status', '--json'], stderr=subprocess.DEVNULL, timeout=2).decode()
        data = json.loads(out)
        self_node = data.get('Self', {})
        for ip in self_node.get('TailscaleIPs', []):
            if ':' not in ip and is_ts(ip):
                info['ip'] = ip
                break
        dns = self_node.get('DNSName', '').rstrip('.')
        if dns:
            info['magicdns'] = dns
        info['self_name'] = self_node.get('HostName', '')
        info['running'] = bool(self_node.get('Online', False))
        info['mode'] = 'cli'
        if info['ip']:
            print(json.dumps(info))
            exit(0)
    except Exception:
        pass

for cmd in [['ip', '-4', 'addr'], ['ifconfig']]:
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL, timeout=2).decode()
        cur_iface = ''
        for line in out.splitlines():
            if line and not line.startswith(' '):
                cur_iface = line.split(':')[0].split()[0].strip()
            m = re.search(r'inet\s+(\d+\.\d+\.\d+\.\d+)', line)
            if m:
                ip = m.group(1)
                if is_ts(ip):
                    info['running'] = True
                    info['ip'] = ip
                    info['mode'] = 'android-app' if 'tun' in cur_iface else 'interface'
                    print(json.dumps(info))
                    exit(0)
    except Exception:
        pass

print(json.dumps(info))
" 2>/dev/null
}

show_tailscale_gateway() {
    echo -e "${C_BLUE}╭────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_BLUE}│${C_RESET}             ${C_BOLD}TAILSCALE MESH VPN & PEER CONNECTIVITY${C_RESET}             ${C_BLUE}│${C_RESET}"
    echo -e "${C_BLUE}╰────────────────────────────────────────────────────────────────╯${C_RESET}"

    local ts_json
    ts_json=$(get_tailscale_json)

    local ts_running
    ts_running=$(python3 -c "import json; data=json.loads('''$ts_json'''); print('true' if data.get('running') else 'false')")
    local ts_ip
    ts_ip=$(python3 -c "import json; data=json.loads('''$ts_json'''); print(data.get('ip') or '')")
    local ts_dns
    ts_dns=$(python3 -c "import json; data=json.loads('''$ts_json'''); print(data.get('magicdns') or '')")
    local ts_installed
    ts_installed=$(python3 -c "import json; data=json.loads('''$ts_json'''); print('true' if data.get('installed') else 'false')")
    local ts_mode
    ts_mode=$(python3 -c "import json; data=json.loads('''$ts_json'''); print(data.get('mode') or 'none')")

    if [ "$ts_running" = "true" ] && [ -n "$ts_ip" ]; then
        local ts_url="http://${ts_ip}:${PORT}"
        echo -e "  • Tailscale Status: ${C_GREEN}${C_BOLD}CONNECTED${C_RESET} (${C_DIM}mode: ${ts_mode}${C_RESET})"
        echo -e "  • Tailscale IPv4  : ${C_GREEN}${ts_ip}${C_RESET}"
        if [ -n "$ts_dns" ]; then
            echo -e "  • MagicDNS Domain : ${C_CYAN}${ts_dns}${C_RESET}"
            echo -e "  • MagicDNS URL    : ${C_CYAN}http://${ts_dns}:${PORT}/${C_RESET}"
        fi
        echo -e "  • Web Chat UI Link: ${C_GREEN}${ts_url}/${C_RESET}"
        echo -e "  • OpenAI Endpoint : ${C_CYAN}${ts_url}/v1${C_RESET}"
        echo -e "  • API Key (Header): ${C_YELLOW}sk-test${C_RESET}"
        ping_test "$ts_url"
        copy_clipboard "$ts_url"

        echo -e "${C_BLUE}──────────────────────────────────────────────────────────────────${C_RESET}"
        show_qr "$ts_url"
        echo -e "${C_BLUE}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_BOLD}How to Connect from Any Other Device on your Tailnet:${C_RESET}"
        echo -e "    1. Connect your laptop, tablet, or secondary phone to your Tailscale account."
        echo -e "    2. Open your browser and navigate directly to: ${C_GREEN}${ts_url}/${C_RESET}"
        if [ -n "$ts_dns" ]; then
            echo -e "       or using MagicDNS: ${C_CYAN}http://${ts_dns}:${PORT}/${C_RESET}"
        fi
        echo -e "    3. Zero port forwarding, zero public exposure, encrypted peer-to-peer!"

        if [ "$ts_installed" = "true" ]; then
            echo -e "\n  ${C_BOLD}Tailscale CLI Features Available:${C_RESET}"
            echo -e "    • Run ${C_CYAN}wola.link tailscale serve on${C_RESET}  -> Expose over HTTPS within Tailnet"
            echo -e "    • Run ${C_CYAN}wola.link tailscale funnel on${C_RESET} -> Expose publicly over HTTPS via Funnel"
        fi
    else
        echo -e "  • Tailscale Status: ${C_RED}NOT ACTIVE${C_RESET}"
        echo -e ""
        echo -e "  ${C_BOLD}Why use Tailscale with Wola?${C_RESET}"
        echo -e "  Tailscale connects your phone and PC over an encrypted WireGuard mesh network."
        echo -e "  You can access Wola from anywhere in the world without SSH tunnels or public relays."
        echo -e ""
        echo -e "  ${C_BOLD}How to activate Tailscale:${C_RESET}"
        echo -e "  ${C_CYAN}[Android]${C_RESET}"
        echo -e "    1. Install ${C_BOLD}Tailscale${C_RESET} from Google Play Store or F-Droid."
        echo -e "    2. Log in and toggle Tailscale ON."
        echo -e "    3. Re-run ${C_BOLD}wola.link tailscale${C_RESET} to view your connection link."
        echo -e ""
        echo -e "  ${C_CYAN}[Linux]${C_RESET}"
        echo -e "    1. Run: ${C_YELLOW}curl -fsSL https://tailscale.com/install.sh | sh${C_RESET}"
        echo -e "    2. Run: ${C_YELLOW}tailscale up${C_RESET}"
        echo -e "    3. Re-run ${C_BOLD}wola.link tailscale${C_RESET}."
    fi
    echo -e "${C_BLUE}=================================================================${C_RESET}"
}

manage_tailscale_cli() {
    local action="$1"
    local param="$2"

    if ! command -v tailscale >/dev/null 2>&1; then
        echo -e "${C_RED}[-] 'tailscale' CLI binary not found in PATH.${C_RESET}"
        echo "    On Android, Tailscale runs as an app. Use 'wola.link tailscale' to view connection."
        return 1
    fi

    case "$action" in
        "serve")
            case "$param" in
                "on"|"enable")
                    echo -e "${C_CYAN}[*] Enabling Tailscale Serve for port ${PORT}...${C_RESET}"
                    tailscale serve --bg "http://127.0.0.1:${PORT}"
                    echo -e "${C_GREEN}✓ Tailscale Serve enabled. Accessible via your Tailnet HTTPS MagicDNS!${C_RESET}"
                    ;;
                "off"|"disable")
                    echo -e "${C_YELLOW}[*] Disabling Tailscale Serve...${C_RESET}"
                    tailscale serve --reset 2>/dev/null || true
                    echo -e "${C_GREEN}✓ Tailscale Serve reset.${C_RESET}"
                    ;;
                *)
                    tailscale serve status
                    ;;
            esac
            ;;
        "funnel")
            case "$param" in
                "on"|"enable")
                    echo -e "${C_CYAN}[*] Enabling Tailscale Funnel for port ${PORT}...${C_RESET}"
                    tailscale funnel --bg "${PORT}"
                    echo -e "${C_GREEN}✓ Tailscale Funnel enabled! Publicly accessible over HTTPS.${C_RESET}"
                    ;;
                "off"|"disable")
                    echo -e "${C_YELLOW}[*] Disabling Tailscale Funnel...${C_RESET}"
                    tailscale funnel --reset 2>/dev/null || true
                    echo -e "${C_GREEN}✓ Tailscale Funnel reset.${C_RESET}"
                    ;;
                *)
                    tailscale funnel status
                    ;;
            esac
            ;;
        "status")
            tailscale status
            ;;
        *)
            show_tailscale_gateway
            ;;
    esac
}

# -------------------------------------------------------------
# Local Network & Hotspot Module
# -------------------------------------------------------------
get_local_net_json() {
    python3 -c "
import subprocess, re, socket, json, shutil

def is_ts(ip):
    try:
        parts = [int(p) for p in ip.split('.')]
        return len(parts) == 4 and parts[0] == 100 and (64 <= parts[1] <= 127)
    except Exception:
        return False

interfaces = []
seen = set()
port = '${PORT}'

# Check Tailscale first
ts_bin = shutil.which('tailscale')
if ts_bin:
    try:
        out = subprocess.check_output([ts_bin, 'status', '--json'], stderr=subprocess.DEVNULL, timeout=2).decode()
        data = json.loads(out)
        self_node = data.get('Self', {})
        for ip in self_node.get('TailscaleIPs', []):
            if ':' not in ip and is_ts(ip):
                seen.add(ip)
                interfaces.append({'iface': 'tailscale', 'ip': ip, 'label': 'Tailscale Mesh VPN', 'url': f'http://{ip}:{port}'})
                break
    except Exception:
        pass

for cmd in [['ifconfig'], ['ip', '-4', 'addr']]:
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL).decode()
        cur_iface = ''
        for line in out.splitlines():
            if line and not line.startswith(' '):
                cur_iface = line.split(':')[0].split()[0].strip()
            m = re.search(r'inet\s+(\d+\.\d+\.\d+\.\d+)', line)
            if m:
                ip = m.group(1)
                if ip != '127.0.0.1' and not ip.startswith('169.254.') and ip not in seen:
                    seen.add(ip)
                    if is_ts(ip):
                        label = 'Tailscale Mesh VPN'
                    elif 'ap' in cur_iface or 'swlan' in cur_iface or ip.startswith('192.168.43.'):
                        label = 'Android Mobile Hotspot'
                    elif 'rndis' in cur_iface or 'usb' in cur_iface or ip.startswith('192.168.42.'):
                        label = 'USB Tethering'
                    else:
                        label = 'Local Wi-Fi / LAN'
                    interfaces.append({'iface': cur_iface or 'net', 'ip': ip, 'label': label, 'url': f'http://{ip}:{port}'})
        if interfaces:
            break
    except Exception:
        pass

for probe in ['8.8.8.8', '192.168.43.254', '192.168.1.1']:
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect((probe, 80))
        ip = s.getsockname()[0]
        s.close()
        if ip and ip != '127.0.0.1' and ip not in seen:
            seen.add(ip)
            label = 'Tailscale Mesh VPN' if is_ts(ip) else 'Local Wi-Fi / LAN'
            interfaces.append({'iface': 'sock', 'ip': ip, 'label': label, 'url': f'http://{ip}:{port}'})
    except Exception:
        pass

if '192.168.43.1' not in seen:
    interfaces.append({'iface': 'hotspot', 'ip': '192.168.43.1', 'label': 'Android Mobile Hotspot (Gateway)', 'url': f'http://192.168.43.1:{port}'})

print(json.dumps(interfaces))
" 2>/dev/null
}

show_local_gateway() {
    echo -e "${C_CYAN}╭────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_CYAN}│${C_RESET}             ${C_BOLD}WOLARC AIR-GAPPED LOCAL OFFLINE GATEWAY${C_RESET}            ${C_CYAN}│${C_RESET}"
    echo -e "${C_CYAN}╰────────────────────────────────────────────────────────────────╯${C_RESET}"

    local net_json
    net_json=$(get_local_net_json)

    local primary_local_url="http://192.168.43.1:${PORT}"
    if [ -n "$net_json" ]; then
        python3 -c "
import json
data = json.loads('''$net_json''')
for item in data:
    lbl = item.get('label', 'Local')
    url = item.get('url', '')
    color = '\033[1;34m' if 'Tailscale' in lbl else '\033[1;32m'
    print(f\"  • {lbl:<32} : {color}{url}\033[0m\")
"
        primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
    else
        echo -e "  • Android Mobile Hotspot (Gateway): ${C_GREEN}http://192.168.43.1:${PORT}${C_RESET}"
    fi

    echo -e "  • Web Chat & Pairing UI           : ${C_GREEN}${primary_local_url}/${C_RESET}"
    echo -e "  • OpenAI Compatible Base URL      : ${C_CYAN}${primary_local_url}/v1${C_RESET}"
    echo -e "  • API Key (Header)                : ${C_YELLOW}sk-test${C_RESET}"
    copy_clipboard "$primary_local_url"

    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
    show_qr "$primary_local_url"
    echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
    echo -e "  ${C_BOLD}HOW TO CONNECT WITHOUT INTERNET OR WI-FI ROUTER:${C_RESET}"
    echo -e "    1. On this Android device: Turn ${C_GREEN}${C_BOLD}ON${C_RESET} Personal / Mobile Hotspot."
    echo -e "    2. On your other device (laptop, tablet, phone): Connect to Hotspot Wi-Fi."
    echo -e "    3. In any browser open: ${C_GREEN}${C_BOLD}http://192.168.43.1:${PORT}${C_RESET} (or scan QR code above)."
    echo -e "    4. Enjoy 100% offline chat and RAG knowledge search!"
    echo -e "${C_CYAN}=================================================================${C_RESET}"
}

# -------------------------------------------------------------
# Connectivity Benchmark & Test Suite
# -------------------------------------------------------------
run_connectivity_test() {
    echo -e "${C_CYAN}=================================================================${C_RESET}"
    echo -e "               ${C_BOLD}WOLARC CONNECTIVITY BENCHMARK & AUDIT${C_RESET}"
    echo -e "${C_CYAN}=================================================================${C_RESET}"

    test_target() {
        local name="$1"
        local url="$2"
        printf "  • %-32s : " "$name"
        if [ -z "$url" ]; then
            echo -e "${C_DIM}N/A (Not configured)${C_RESET}"
            return
        fi

        local start_ms=$(python3 -c "import time; print(int(time.time()*1000))")
        local code
        code=$(curl -s -o /dev/null -w "%{http_code}" -m 5 "${url}/health" 2>/dev/null)
        local end_ms=$(python3 -c "import time; print(int(time.time()*1000))")
        local diff=$((end_ms - start_ms))

        if [ "$code" = "200" ] || [ "$code" = "204" ]; then
            echo -e "${C_GREEN}${code} OK (${diff}ms)${C_RESET}"
        elif [ "$code" = "000" ]; then
            echo -e "${C_RED}FAILED (Unreachable / Timeout)${C_RESET}"
        else
            echo -e "${C_YELLOW}HTTP ${code} (${diff}ms)${C_RESET}"
        fi
    }

    test_target "Localhost Loopback" "http://127.0.0.1:${PORT}"

    # Test LAN
    local net_json
    net_json=$(get_local_net_json)
    if [ -n "$net_json" ]; then
        python3 -c "
import json
data = json.loads('''$net_json''')
for item in data:
    lbl = item.get('label', '')
    url = item.get('url', '')
    print(f'{lbl}|{url}')
" | while IFS='|' read -r lbl url; do
            [ -n "$url" ] && test_target "$lbl" "$url"
        done
    fi

    # Test Active Remote Tunnel
    local cur_url
    cur_url=$(get_url)
    local cur_prov
    cur_prov=$(get_provider)
    if [ -n "$cur_url" ]; then
        test_target "Public Tunnel (${cur_prov})" "$cur_url"
    else
        printf "  • %-32s : ${C_YELLOW}OFFLINE${C_RESET}\n" "Public Tunnel"
    fi

    echo -e "${C_CYAN}-----------------------------------------------------------------${C_RESET}"
    echo -e "  ${C_BOLD}Outbound Provider Reachability Probe:${C_RESET}"

    probe_host() {
        local pname="$1"
        local host="$2"
        local port="$3"
        printf "    • %-28s : " "$pname ($host)"
        if nc -z -w 3 "$host" "$port" 2>/dev/null || (exec 3<>/dev/tcp/"$host"/"$port") 2>/dev/null; then
            echo -e "${C_GREEN}REACHABLE${C_RESET}"
        else
            echo -e "${C_YELLOW}BLOCKED / TIMEOUT${C_RESET}"
        fi
    }

    probe_host "localhost.run" "localhost.run" "22"
    probe_host "serveo.net" "serveo.net" "22"
    probe_host "pinggy.io" "a.pinggy.io" "22"
    if command -v cloudflared >/dev/null 2>&1; then
        printf "    • %-28s : ${C_GREEN}INSTALLED (Ready)${C_RESET}\n" "Cloudflare Tunnel"
    fi
    echo -e "${C_CYAN}=================================================================${C_RESET}"
}

# -------------------------------------------------------------
# Status Overview
# -------------------------------------------------------------
show_status_overview() {
    echo -e "${C_CYAN}=================================================================${C_RESET}"
    echo -e "                 ${C_BOLD}WOLARC CONNECTIVITY STATUS${C_RESET}"
    echo -e "${C_CYAN}=================================================================${C_RESET}"

    local url
    url=$(get_url)
    local prov
    prov=$(get_provider)

    echo -e "  ${C_BOLD}[Remote Gateways]${C_RESET}"
    if [ -n "$url" ]; then
        echo -e "    • Public Tunnel URL : ${C_GREEN}${url}${C_RESET} (${C_DIM}provider: ${prov}${C_RESET})"
        ping_test "$url"
    else
        echo -e "    • Public Tunnel     : ${C_RED}OFFLINE${C_RESET}"
    fi

    local w_pid=""
    [ -f "$PID_FILE" ] && w_pid=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$w_pid" ] && kill -0 "$w_pid" 2>/dev/null; then
        echo -e "    • Tunnel Watchdog   : ${C_GREEN}ACTIVE (PID $w_pid, Auto-Healing ON)${C_RESET}"
    else
        echo -e "    • Tunnel Watchdog   : ${C_YELLOW}IDLE / NOT RUNNING${C_RESET}"
    fi

    echo -e "\n  ${C_BOLD}[Mesh & Private Networks]${C_RESET}"
    local ts_json
    ts_json=$(get_tailscale_json)
    local ts_running
    ts_running=$(python3 -c "import json; data=json.loads('''$ts_json'''); print('true' if data.get('running') else 'false')")
    local ts_ip
    ts_ip=$(python3 -c "import json; data=json.loads('''$ts_json'''); print(data.get('ip') or '')")
    local ts_dns
    ts_dns=$(python3 -c "import json; data=json.loads('''$ts_json'''); print(data.get('magicdns') or '')")

    if [ "$ts_running" = "true" ] && [ -n "$ts_ip" ]; then
        echo -e "    • Tailscale Mesh    : ${C_GREEN}CONNECTED${C_RESET} (${C_CYAN}${ts_ip}:${PORT}${C_RESET})"
        [ -n "$ts_dns" ] && echo -e "    • MagicDNS Hostname : ${C_CYAN}${ts_dns}${C_RESET}"
    else
        echo -e "    • Tailscale Mesh    : ${C_DIM}Disconnected (run 'wola.link tailscale' to connect)${C_RESET}"
    fi

    echo -e "\n  ${C_BOLD}[Local Interfaces]${C_RESET}"
    local net_json
    net_json=$(get_local_net_json)
    if [ -n "$net_json" ]; then
        python3 -c "
import json
data = json.loads('''$net_json''')
for item in data:
    lbl = item.get('label', '')
    url = item.get('url', '')
    if 'Tailscale' not in lbl:
        print(f\"    • {lbl:<22} : {url}\")
"
    fi
    echo -e "${C_CYAN}=================================================================${C_RESET}"
}

# -------------------------------------------------------------
# Dispatcher
# -------------------------------------------------------------
SELF_NAME=$(basename "$0")
URL=$(get_url)
PROVIDER=$(get_provider)

# If invoked as wola.ts or wola.tailscale
if [ "$SELF_NAME" = "wola.ts" ] || [ "$SELF_NAME" = "wola.tailscale" ]; then
    if [ -n "$1" ]; then
        manage_tailscale_cli "$@"
    else
        show_tailscale_gateway
    fi
    exit 0
fi

# If invoked as wola.local or wola.hotspot
if [ "$SELF_NAME" = "wola.local" ] || [ "$SELF_NAME" = "wola.hotspot" ]; then
    case "$1" in
        "tailscale"|"ts")
            shift
            if [ -n "$1" ]; then
                manage_tailscale_cli "$@"
            else
                show_tailscale_gateway
            fi
            exit 0
            ;;
        "test")
            run_connectivity_test
            exit 0
            ;;
        "status")
            show_status_overview
            exit 0
            ;;
        "copy")
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            copy_clipboard "$primary_local_url"
            exit 0
            ;;
        "raw")
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            echo "$primary_local_url"
            exit 0
            ;;
        "api"|"endpoint")
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            echo "${primary_local_url}/v1"
            exit 0
            ;;
        "qr")
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            show_qr "$primary_local_url"
            exit 0
            ;;
        "-h"|"--help"|"help")
            echo -e "${C_BOLD}Wolarc Local Offline Gateway (wola.hotspot / wola.local)${C_RESET}"
            echo "Usage:"
            echo "  wola.hotspot (or wola.local)     Show offline local links, Hotspot IP & QR code"
            echo "  wola.hotspot tailscale           Display Tailscale mesh IP, MagicDNS & setup"
            echo "  wola.hotspot test                Benchmark all local and remote connectivity routes"
            echo "  wola.hotspot status              Audit all connection interfaces"
            echo "  wola.hotspot copy                Copy primary local URL to clipboard"
            echo "  wola.hotspot qr                  Display large terminal QR code"
            exit 0
            ;;
        *)
            show_local_gateway
            exit 0
            ;;
    esac
fi

# Invoked as wola.url or wola.link
case "$1" in
    "tailscale"|"ts")
        shift
        if [ -n "$1" ]; then
            manage_tailscale_cli "$@"
        else
            show_tailscale_gateway
        fi
        ;;
    "test"|"bench")
        run_connectivity_test
        ;;
    "status"|"check")
        show_status_overview
        ;;
    "local"|"offline"|"hotspot"|"lan")
        show_local_gateway
        ;;
    "raw")
        [ -n "$URL" ] && echo "$URL" || exit 1
        ;;
    "endpoint"|"api")
        [ -n "$URL" ] && echo "${URL}/v1" || exit 1
        ;;
    "copy")
        if [ -n "$URL" ]; then
            copy_clipboard "$URL"
        else
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            copy_clipboard "$primary_local_url"
        fi
        ;;
    "switch"|"provider")
        target="$2"
        [ -z "$target" ] && target="auto"
        if command -v wola-tunnel-daemon >/dev/null 2>&1; then
            wola-tunnel-daemon reconnect "$target"
        else
            m_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
            "$m_dir/wola-tunnel-daemon" reconnect "$target"
        fi
        ;;
    "reconnect")
        if command -v wola-tunnel-daemon >/dev/null 2>&1; then
            wola-tunnel-daemon reconnect
        else
            m_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
            "$m_dir/wola-tunnel-daemon" reconnect
        fi
        ;;
    "qr")
        if [ -n "$2" ]; then
            show_qr "$2"
        elif [ -n "$URL" ]; then
            show_qr "$URL"
        else
            net_json=$(get_local_net_json)
            primary_local_url=$(python3 -c "import json; data=json.loads('''$net_json'''); print(data[0]['url'] if data else 'http://192.168.43.1:${PORT}')")
            show_qr "$primary_local_url"
        fi
        ;;
    "-h"|"--help"|"help")
        echo -e "${C_BOLD}Wolarc Remote Gateway & Connectivity Suite (wola.link / wola.url)${C_RESET}"
        echo "Usage:"
        echo "  wola.link (or wola.url)           Display active public URL, latency & QR code"
        echo "  wola.link tailscale               Inspect Tailscale mesh VPN, MagicDNS & peer links"
        echo "  wola.link local (or wola.hotspot) Display offline Hotspot & Wi-Fi LAN interfaces"
        echo "  wola.link test                    Benchmark reachability across all network routes"
        echo "  wola.link status                  Audit connection health & watchdog status"
        echo "  wola.link switch <provider>       Switch tunnel (cloudflare, localhost.run, serveo, pinggy)"
        echo "  wola.link reconnect               Force reconnect active tunnel across fallback cascade"
        echo "  wola.link copy                    Copy active endpoint to clipboard"
        echo "  wola.link qr                      Display enlarged ASCII QR code"
        exit 0
        ;;
    *)
        echo -e "${C_CYAN}╭────────────────────────────────────────────────────────────────╮${C_RESET}"
        echo -e "${C_CYAN}│${C_RESET}               ${C_BOLD}WOLARC REMOTE GATEWAY & TUNNEL URL${C_RESET}               ${C_CYAN}│${C_RESET}"
        echo -e "${C_CYAN}╰────────────────────────────────────────────────────────────────╯${C_RESET}"
        if [ -z "$URL" ]; then
            echo -e "  ${C_RED}○ Remote Tunnel : OFFLINE / DISCONNECTED${C_RESET}"
            echo -e "  ${C_DIM}(Start Wola with 'wola.start' or run 'wola.link reconnect')${C_RESET}"
            echo ""
            show_local_gateway
            exit 0
        fi

        echo -e "  • Public Base URL : ${C_GREEN}${C_BOLD}${URL}${C_RESET}"
        echo -e "  • OpenAI Endpoint : ${C_CYAN}${URL}/v1/chat/completions${C_RESET}"
        echo -e "  • API Key (Header): ${C_YELLOW}sk-test${C_RESET}"
        echo -e "  • Tunnel Provider : ${C_DIM}${PROVIDER}${C_RESET}"
        ping_test "$URL"
        copy_clipboard "$URL"

        # Check Tailscale quick status
        local ts_json
        ts_json=$(get_tailscale_json)
        local ts_ip
        ts_ip=$(python3 -c "import json; data=json.loads('''$ts_json'''); print(data.get('ip') or '')")
        if [ -n "$ts_ip" ]; then
            echo -e "  • Tailscale Mesh  : ${C_BLUE}${C_BOLD}http://${ts_ip}:${PORT}${C_RESET} (Tailnet active)"
        fi

        echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
        show_qr "$URL"
        echo -e "${C_CYAN}──────────────────────────────────────────────────────────────────${C_RESET}"
        echo -e "  ${C_BOLD}Alternative Connectivity Routes:${C_RESET}"
        echo -e "    • Tailscale Mesh : ${C_BLUE}wola.link tailscale${C_RESET} (Encrypted peer-to-peer)"
        echo -e "    • Offline Hotspot: ${C_GREEN}wola.hotspot${C_RESET}        (Zero-internet Wi-Fi/AP)"
        echo -e "    • Network Audit  : ${C_CYAN}wola.link status${C_RESET}    (Complete connectivity audit)"
        echo -e "    • Network Test   : ${C_YELLOW}wola.link test${C_RESET}      (Benchmark latency of all routes)"
        echo -e "${C_CYAN}=================================================================${C_RESET}"
        ;;
esac
