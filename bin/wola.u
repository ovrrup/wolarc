#!/data/data/com.termux/files/usr/bin/bash

# ANSI Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_MAGENTA="\033[1;35m"
C_DIM="\033[2m"

CONFIG="$HOME/.wolarc"
LOCK="$HOME/.wola.lock"
CACHE_FILE="$HOME/.wola_update_cache.json"
REPO_OWNER="ovrrup"
REPO_NAME="wolarc"
GITHUB_API="https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/commits/main"

# Find source repository directory
find_repo_dir() {
    # 1. Check environment or config
    if [ -n "$WOLA_SOURCE_DIR" ] && [ -d "$WOLA_SOURCE_DIR/.git" ]; then
        echo "$WOLA_SOURCE_DIR"
        return
    fi

    # 2. Check current script's parent repository
    local script_dir
    script_dir=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
    local parent_dir
    parent_dir=$(dirname "$script_dir")
    if [ -d "$parent_dir/.git" ]; then
        echo "$parent_dir"
        return
    fi

    # 3. Check standard ~/wola directory
    if [ -d "$HOME/wola/.git" ]; then
        echo "$HOME/wola"
        return
    fi

    echo ""
}

REPO_DIR=$(find_repo_dir)

save_cache() {
    local has_update="$1"
    local remote_sha="$2"
    local message="$3"
    python3 -c "
import json, time, os
data = {
    'last_checked': time.time(),
    'update_available': '$has_update' == 'true',
    'remote_sha': '$remote_sha',
    'message': '''$message'''.strip()
}
try:
    with open(os.path.expanduser('$CACHE_FILE'), 'w') as f:
        json.dump(data, f)
except Exception:
    pass
" 2>/dev/null
}

get_current_commit() {
    if [ -n "$REPO_DIR" ] && [ -d "$REPO_DIR/.git" ]; then
        git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null
    elif [ -f "$HOME/.wola_version" ]; then
        head -n 1 "$HOME/.wola_version" | cut -c1-7
    else
        echo "unknown"
    fi
}

check_updates() {
    local silent="$1"
    local current_sha
    current_sha=$(get_current_commit)

    if [ "$silent" != "true" ]; then
        echo -e "${C_CYAN}=================================================================${C_RESET}"
        echo -e "                   ${C_BOLD}WOLARC UPDATE CHECKER${C_RESET}"
        echo -e "${C_CYAN}=================================================================${C_RESET}"
        echo -n -e "[*] Contacting GitHub (github.com/${REPO_OWNER}/${REPO_NAME})... "
    fi

    local remote_sha=""
    local commit_msg=""
    local commit_date=""

    if [ -n "$REPO_DIR" ] && [ -d "$REPO_DIR/.git" ]; then
        git -C "$REPO_DIR" fetch origin main --quiet 2>/dev/null
        remote_sha=$(git -C "$REPO_DIR" rev-parse --short origin/main 2>/dev/null)
        local full_current
        full_current=$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null)
        local full_remote
        full_remote=$(git -C "$REPO_DIR" rev-parse origin/main 2>/dev/null)

        if [ "$silent" != "true" ]; then
            echo -e "${C_GREEN}OK${C_RESET}"
        fi

        if [ "$full_current" != "$full_remote" ] && [ -n "$full_remote" ]; then
            local count
            count=$(git -C "$REPO_DIR" rev-list --count HEAD..origin/main 2>/dev/null)
            commit_msg=$(git -C "$REPO_DIR" log -n 1 --pretty=format:"%s" origin/main 2>/dev/null)
            save_cache "true" "$remote_sha" "$commit_msg"

            if [ "$silent" != "true" ]; then
                echo ""
                echo -e "  ${C_YELLOW}⚡ An update is available!${C_RESET}"
                echo -e "  Installed version : ${C_DIM}${current_sha}${C_RESET}"
                echo -e "  Latest version    : ${C_GREEN}${remote_sha}${C_RESET} (${count} commit(s) ahead)"
                echo ""
                echo -e "  ${C_BOLD}Latest Commit Summary:${C_RESET}"
                echo -e "  ${C_CYAN}•${C_RESET} ${commit_msg}"
                echo ""
                echo -e "  ${C_BOLD}Commits to be applied:${C_RESET}"
                git -C "$REPO_DIR" log --oneline HEAD..origin/main | head -n 5 | while read -r line; do
                    echo -e "    ${C_DIM}${line}${C_RESET}"
                done
                echo -e "${C_CYAN}=================================================================${C_RESET}"
            fi
            return 1
        else
            save_cache "false" "$current_sha" "Up to date"
            if [ "$silent" != "true" ]; then
                echo ""
                echo -e "  ${C_GREEN}✓ You are using the latest version of Wola!${C_RESET} (${current_sha})"
                echo -e "${C_CYAN}=================================================================${C_RESET}"
            fi
            return 0
        fi
    else
        # Fallback to GitHub API via curl
        local api_res
        api_res=$(curl -s -m 10 "$GITHUB_API")
        remote_sha=$(echo "$api_res" | grep -m1 '"sha":' | cut -d '"' -f 4 | cut -c1-7)
        commit_msg=$(echo "$api_res" | grep -m1 '"message":' | cut -d '"' -f 4 | head -n 1)

        if [ "$silent" != "true" ]; then
            echo -e "${C_GREEN}OK${C_RESET}"
        fi

        if [ -n "$remote_sha" ] && [ "$remote_sha" != "$current_sha" ]; then
            save_cache "true" "$remote_sha" "$commit_msg"
            if [ "$silent" != "true" ]; then
                echo ""
                echo -e "  ${C_YELLOW}⚡ An update is available!${C_RESET}"
                echo -e "  Installed version : ${C_DIM}${current_sha}${C_RESET}"
                echo -e "  Latest version    : ${C_GREEN}${remote_sha}${C_RESET}"
                echo -e "  Latest Commit     : ${commit_msg}"
                echo -e "${C_CYAN}=================================================================${C_RESET}"
            fi
            return 1
        else
            save_cache "false" "$current_sha" "Up to date"
            if [ "$silent" != "true" ]; then
                echo ""
                echo -e "  ${C_GREEN}✓ You are using the latest version of Wola!${C_RESET} (${current_sha})"
                echo -e "${C_CYAN}=================================================================${C_RESET}"
            fi
            return 0
        fi
    fi
}

install_updates() {
    echo -e "${C_CYAN}=================================================================${C_RESET}"
    echo -e "                    ${C_BOLD}APPLYING WOLARC UPDATE${C_RESET}"
    echo -e "${C_CYAN}=================================================================${C_RESET}"

    if [ -n "$REPO_DIR" ] && [ -d "$REPO_DIR/.git" ]; then
        echo -e "[*] Pulling latest changes into ${REPO_DIR}..."
        git -C "$REPO_DIR" pull origin main
        local new_sha
        new_sha=$(git -C "$REPO_DIR" rev-parse --short HEAD)
        echo "$new_sha" > "$HOME/.wola_version"

        echo -e "[*] Running installer wizard to re-link binaries..."
        bash "$REPO_DIR/install.sh" --upgrade

        save_cache "false" "$new_sha" "Up to date"
    else
        echo -e "[*] Cloning/updating repository into $HOME/wola..."
        if [ ! -d "$HOME/wola" ]; then
            git clone "https://github.com/${REPO_OWNER}/${REPO_NAME}.git" "$HOME/wola"
        else
            git -C "$HOME/wola" pull origin main
        fi
        bash "$HOME/wola/install.sh" --upgrade
        save_cache "false" "$(git -C "$HOME/wola" rev-parse --short HEAD)" "Up to date"
    fi

    # Check if Wola is currently running
    if [ -f "$LOCK" ] || pgrep -f "agent.py" >/dev/null 2>&1; then
        echo ""
        echo -e "${C_YELLOW}[!] Wola services are currently RUNNING.${C_RESET}"
        read -p "    Restart services now to apply updates immediately? (Y/n): " restart_ans
        restart_ans=${restart_ans:-y}
        if [[ "$restart_ans" =~ ^[Yy] ]]; then
            wola.rs
        else
            echo -e "    ${C_DIM}Run 'wola.rs' manually when you wish to reload services.${C_RESET}"
        fi
    fi

    echo ""
    echo -e "${C_GREEN}[+] Update complete! Wolarc is up to date.${C_RESET}"
    echo -e "${C_CYAN}=================================================================${C_RESET}"
}

interactive_flow() {
    if ! check_updates "false"; then
        read -p "Install this update now? (Y/n): " ans
        ans=${ans:-y}
        if [[ "$ans" =~ ^[Yy] ]]; then
            install_updates
        else
            echo -e "${C_DIM}Update skipped.${C_RESET}"
        fi
    fi
}

case "$1" in
    "check"|"status")
        check_updates "false"
        ;;
    "silent-check")
        check_updates "true"
        ;;
    "install"|"apply"|"upgrade")
        install_updates
        ;;
    "version")
        echo -e "Wolarc Version: ${C_BOLD}$(get_current_commit)${C_RESET}"
        ;;
    *)
        interactive_flow
        ;;
esac
