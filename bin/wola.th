#!/data/data/com.termux/files/usr/bin/python3
import os, sys, time, atexit

LOG_FILE = os.path.expanduser("~/.wola/logs/thinking.log")
if not os.path.exists(LOG_FILE) and os.path.exists(os.path.expanduser("~/.wola_thinking.log")):
    LOG_FILE = os.path.expanduser("~/.wola_thinking.log")

C_RESET   = "\033[0m"
C_BOLD    = "\033[1m"
C_DIM     = "\033[2m"
C_GREEN   = "\033[1;32m"
C_YELLOW  = "\033[1;33m"
C_CYAN    = "\033[1;36m"
C_MAGENTA = "\033[1;35m"
C_WHITE   = "\033[1;37m"

def cleanup():
    sys.stdout.write(C_RESET + "\n")
    sys.stdout.flush()

atexit.register(cleanup)

def print_header():
    sys.stdout.write("\033[2J\033[H")
    print(f"{C_MAGENTA}╭────────────────────────────────────────────────────────────────╮{C_RESET}")
    print(f"{C_MAGENTA}│{C_RESET}       {C_BOLD}WOLARC REAL-TIME INFERENCE & THINKING MONITOR{C_RESET}            {C_MAGENTA}│{C_RESET}")
    print(f"{C_MAGENTA}╰────────────────────────────────────────────────────────────────╯{C_RESET}")
    print(f"  Streaming live reasoning tokens (<think>), RAG events & answers.")
    print(f"  {C_DIM}Press Ctrl+C to detach monitor at any time.{C_RESET}\n")

def stream_thinking():
    print_header()

    if not os.path.exists(LOG_FILE):
        try:
            os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
            open(LOG_FILE, "w").close()
        except Exception:
            pass

    in_think_block = False

    with open(LOG_FILE, "r", encoding="utf-8", errors="ignore") as f:
        # Seek to end of log
        f.seek(0, os.SEEK_END)
        print(f"{C_DIM}[*] Awaiting incoming query from client...{C_RESET}\n")

        while True:
            line = f.readline()
            if not line:
                time.sleep(0.08)
                continue

            # Event triggers
            if line.startswith("[PROMPT_START] "):
                query = line[15:].strip()
                t_str = time.strftime("%H:%M:%S")
                print(f"\n{C_CYAN}──────────────────────────────────────────────────────────────────{C_RESET}")
                print(f"{C_CYAN}[{t_str}] USER QUERY:{C_RESET} {C_BOLD}{query}{C_RESET}")
            elif line.startswith("[RAG_MATCH] "):
                match_info = line[12:].strip()
                print(f"  {C_YELLOW}↳ [RAG MATCH]{C_RESET} {match_info}")
            elif line.startswith("[STREAM_START]"):
                print(f"\n{C_GREEN}▶ [GENERATION STREAM]:{C_RESET}")
                in_think_block = False
            elif line.startswith("[STREAM_END]"):
                if in_think_block:
                    sys.stdout.write(C_RESET)
                    in_think_block = False
                print(f"\n{C_DIM}■ [Finished - generation completed]{C_RESET}\n")
            else:
                # Token processing
                text = line
                if "<think>" in text:
                    parts = text.split("<think>")
                    sys.stdout.write(parts[0])
                    sys.stdout.write(f"\n{C_MAGENTA}{C_DIM}╭── [Thinking Process] ──────────────────────────────────────────\n│ ")
                    in_think_block = True
                    sys.stdout.write(parts[1].replace("\n", "\n│ "))
                elif "</think>" in text:
                    parts = text.split("</think>")
                    sys.stdout.write(parts[0].replace("\n", "\n│ "))
                    sys.stdout.write(f"\n{C_MAGENTA}╰────────────────────────────────────────────────────────────────{C_RESET}\n\n{C_GREEN}╭── [Final Response] ───────────────────────────────────────────\n{C_RESET}")
                    in_think_block = False
                    sys.stdout.write(parts[1])
                else:
                    if in_think_block and "\n" in text:
                        text = text.replace("\n", "\n│ ")
                    sys.stdout.write(text)
                sys.stdout.flush()

def handle_cli_args():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        if arg in ["-h", "--help", "help"]:
            print(f"{C_BOLD}Wolarc Real-Time Reasoning & Thinking Monitor{C_RESET}")
            print("Usage:")
            print("  wola.th (or wola.think)         Follow live reasoning stream (<think> tokens)")
            print("  wola.th on                      Enable model thinking / deep reasoning")
            print("  wola.th off                     Disable thinking (direct fast answer mode)")
            print("  wola.th status                  Check current thinking state")
            sys.exit(0)
        cfg_path = os.path.expanduser("~/.wolarc")
        if arg in ["on", "enable", "1", "true"]:
            lines = []
            if os.path.exists(cfg_path):
                with open(cfg_path, "r") as f:
                    lines = f.readlines()
            import re
            pat = re.compile(r'^\s*ENABLE_THINKING=.*$')
            if any(pat.match(l) for l in lines):
                lines = [f'ENABLE_THINKING="true"\n' if pat.match(l) else l for l in lines]
            else:
                lines.append('ENABLE_THINKING="true"\n')
            with open(cfg_path, "w") as f:
                f.writelines(lines)
            print(f"{C_GREEN}[+] Model reasoning / thinking mechanism ENABLED (<think> on).{C_RESET}")
            sys.exit(0)
        elif arg in ["off", "disable", "0", "false"]:
            lines = []
            if os.path.exists(cfg_path):
                with open(cfg_path, "r") as f:
                    lines = f.readlines()
            import re
            pat = re.compile(r'^\s*ENABLE_THINKING=.*$')
            if any(pat.match(l) for l in lines):
                lines = [f'ENABLE_THINKING="false"\n' if pat.match(l) else l for l in lines]
            else:
                lines.append('ENABLE_THINKING="false"\n')
            with open(cfg_path, "w") as f:
                f.writelines(lines)
            print(f"{C_YELLOW}[-] Model reasoning / thinking mechanism DISABLED (direct fast answer mode).{C_RESET}")
            sys.exit(0)
        elif arg in ["status"]:
            status_val = "true (enabled)"
            if os.path.exists(cfg_path):
                with open(cfg_path, "r") as f:
                    for line in f:
                        if line.strip().startswith("ENABLE_THINKING="):
                            v = line.split("=", 1)[1].strip("\"' \n").lower()
                            if v in ["false", "0", "off", "no"]:
                                status_val = "false (disabled)"
            print(f"{C_BOLD}Model Thinking Status:{C_RESET} {status_val}")
            print("Usage: wola.th [on|off|status]")
            sys.exit(0)

if __name__ == "__main__":
    handle_cli_args()
    try:
        stream_thinking()
    except KeyboardInterrupt:
        sys.stdout.write(f"\n{C_RESET}Thinking monitor detached.\n")
        sys.exit(0)
