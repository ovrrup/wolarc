#!/data/data/com.termux/files/usr/bin/bash

CONFIG="$HOME/.wolarc"
[ -f "$CONFIG" ] && source "$CONFIG"

WOLA_DIR="$HOME/.wola"
LIB_DIR="$WOLA_DIR/lib"
LOG_DIR="$WOLA_DIR/logs"
RUN_DIR="$WOLA_DIR/run"
DATA_DIR="$WOLA_DIR/data"

LOCK="$RUN_DIR/wola.lock"
[ -f "$HOME/.wola.lock" ] && [ ! -f "$LOCK" ] && LOCK="$HOME/.wola.lock"
MODELS_DIR="${MODELS_DIR:-$HOME/models}"

C_RESET="\033[0m"
C_RED="\033[1;31m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_CYAN="\033[1;36m"
C_BOLD="\033[1m"

ensure_wola_layout() {
    mkdir -p "$LIB_DIR" "$LOG_DIR" "$RUN_DIR" "$DATA_DIR"
    # Migrate loose python scripts from $HOME to ~/.wola/lib
    for py in agent.py indexer.py web_ui.py; do
        if [ -f "$HOME/$py" ] && [ ! -L "$HOME/$py" ]; then
            cp -f "$HOME/$py" "$LIB_DIR/$py" 2>/dev/null || true
            rm -f "$HOME/$py" 2>/dev/null || true
        fi
    done
    rm -rf "$HOME/__pycache__" 2>/dev/null || true

    # Migrate loose logs from $HOME to ~/.wola/logs
    for lf in chat.log embed.log agent.log indexer.log tunnel.log; do
        if [ -f "$HOME/$lf" ] && [ ! -L "$HOME/$lf" ]; then
            mv -f "$HOME/$lf" "$LOG_DIR/$lf" 2>/dev/null || true
        fi
    done
    if [ -f "$HOME/.wola_thinking.log" ] && [ ! -L "$HOME/.wola_thinking.log" ]; then
        mv -f "$HOME/.wola_thinking.log" "$LOG_DIR/thinking.log" 2>/dev/null || true
    fi

    # Migrate runtime dotfiles to ~/.wola/run
    for rf in .wola.lock .wola_url .wola_endpoint .wola_provider .wola_tunnel_daemon.pid \
              .wola_metrics.json .wola_bench_cache.json .wola_update_cache.json .wola_version; do
        local target_name="${rf#.}"
        [ "$rf" = ".wola.lock" ] && target_name="wola.lock"
        if [ -f "$HOME/$rf" ] && [ ! -L "$HOME/$rf" ]; then
            mv -f "$HOME/$rf" "$RUN_DIR/$target_name" 2>/dev/null || true
        fi
    done

    # Migrate vector database to ~/.wola/data
    if [ -f "$HOME/knowledge_db.json" ] && [ ! -f "$DATA_DIR/knowledge_db.json" ]; then
        mv -f "$HOME/knowledge_db.json" "$DATA_DIR/knowledge_db.json" 2>/dev/null || true
        [ -f "$HOME/knowledge_db.json.lock" ] && mv -f "$HOME/knowledge_db.json.lock" "$DATA_DIR/knowledge_db.json.lock" 2>/dev/null || true
    fi

    # Update config paths if pointing to old root locations
    if [ -f "$CONFIG" ]; then
        python3 -c "
import os, re
path = os.path.expanduser('~/.wolarc')
if os.path.exists(path):
    with open(path) as f: lines = f.readlines()
    changed = False
    for i, l in enumerate(lines):
        if re.search(r'^\s*DB_FILE\s*=\s*[\"\'\s]*(\$HOME|~|/data/data/com.termux/files/home)/knowledge_db\.json[\"\'\s]*$', l):
            lines[i] = 'DB_FILE=\"$HOME/.wola/data/knowledge_db.json\"\n'
            changed = True
        elif re.search(r'^\s*METRICS_FILE\s*=\s*[\"\'\s]*(\$HOME|~|/data/data/com.termux/files/home)/\.wola_metrics\.json[\"\'\s]*$', l):
            lines[i] = 'METRICS_FILE=\"$HOME/.wola/run/wola_metrics.json\"\n'
            changed = True
    if changed:
        with open(path, 'w') as f: f.writelines(lines)
" 2>/dev/null || true
    fi
}
ensure_wola_layout

is_running() {
    pgrep -f "llama-server" >/dev/null 2>&1 || \
    pgrep -f "agent.py" >/dev/null 2>&1 || \
    pgrep -f "indexer.py" >/dev/null 2>&1 || \
    pgrep -f "wola-tunnel-daemon" >/dev/null 2>&1 || \
    pgrep -f "cloudflared.*tunnel" >/dev/null 2>&1 || \
    pgrep -f "ssh.*(localhost.run|serveo.net|pinggy.io)" >/dev/null 2>&1
}


is_tui_enabled() {
    [ "${ENABLE_TUI:-true}" != "false" ] && [ "${ENABLE_TUI:-true}" != "0" ] && [ "${ENABLE_TUI:-true}" != "off" ]
}

find_binary() {
    if [ -n "$LLAMA_BIN" ]; then
        if [ -x "$LLAMA_BIN" ]; then
            echo "$LLAMA_BIN"
            return
        fi
        if command -v "$LLAMA_BIN" >/dev/null 2>&1; then
            command -v "$LLAMA_BIN"
            return
        fi
    fi
    if command -v llama-server >/dev/null 2>&1; then
        command -v llama-server
        return
    fi
    for c in "${PREFIX:-/data/data/com.termux/files/usr}/bin/llama-server" \
             "$HOME/.local/bin/llama-server" \
             "/usr/local/bin/llama-server" \
             "/usr/bin/llama-server" \
             "$HOME/llama.cpp/build/bin/llama-server"; do
        if [ -x "$c" ]; then
            echo "$c"
            return
        fi
    done
    local b
    b=$(find "$HOME" -maxdepth 4 -name "llama-server" -type f -perm -111 2>/dev/null | head -n 1)
    if [ -n "$b" ]; then
        echo "$b"
        return
    fi
    echo ""
}

wait_for_service() {
    local url="$1"
    local name="$2"
    local pattern="$3"
    local max_tries=35
    local count=0
    
    echo -n -e "[*] Booting ${C_YELLOW}${name}${C_RESET} "
    while ! curl -s -f "$url" >/dev/null 2>&1; do
        if [ -n "$pattern" ] && ! pgrep -f "$pattern" >/dev/null 2>&1; then
            echo -e " ${C_RED}CRASHED (Process not running)${C_RESET}"
            return 1
        fi
        sleep 1
        count=$((count + 1))
        echo -n "."
        if [ $count -ge $max_tries ]; then
            echo -e " ${C_RED}FAILED (timeout after ${max_tries}s)${C_RESET}"
            return 1
        fi
    done
    echo -e " ${C_GREEN}READY${C_RESET}"
    return 0
}

start_node() {
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        echo -e "${C_BOLD}Wolarc Start Service${C_RESET}"
        echo "Boots all local AI node services (chat, embed, agent API, indexer, tunnel)."
        echo ""
        echo "Usage:"
        echo "  wola.start         (Casual)"
        echo "  wola.r             (Technical)"
        echo "  wola start / wola r"
        return 0
    fi

    if is_running; then
        echo -e "${C_RED}[-] Error: Wola AI Node is ALREADY RUNNING.${C_RESET}"
        echo "    Switch is ON. Run 'wola.k' to turn it off first."
        exit 1
    fi

    if [ -f "$LOCK" ] || [ -f "$RUN_DIR/wola.lock" ] || [ -f "$HOME/.wola.lock" ]; then
        echo -e "${C_YELLOW}[!] Stale lockfile detected (lock exists but no processes running).${C_RESET}"
        echo -e "    [*] Automatically clearing stale lock and releasing resources..."
        rm -f "$LOCK" "$RUN_DIR/wola.lock" "$HOME/.wola.lock"
        command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock 2>/dev/null || true
    fi

    BIN=$(find_binary)
    if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
        echo -e "${C_YELLOW}[!] 'llama-server' binary not found. Attempting automatic installation...${C_RESET}"
        if [ -d "/data/data/com.termux/files/usr/bin" ]; then
            echo -e "    [*] Installing llama-cpp via Termux package manager..."
            pkg install -y llama-cpp >/dev/null 2>&1 || true
        fi
        BIN=$(find_binary)
    fi
    if [ -z "$BIN" ] || [ ! -x "$BIN" ]; then
        echo -e "${C_RED}[-] Error: 'llama-server' binary not found or not executable.${C_RESET}"
        echo "    Install with: pkg install llama-cpp (Termux) or configure LLAMA_BIN in ~/.wolarc"
        exit 1
    fi

    MODELS_DIR="${MODELS_DIR:-$HOME/models}"
    if [ -z "$EMBED_MODEL" ]; then
        EMBED_MODEL=$(find "$MODELS_DIR" -maxdepth 1 \( -iname "*embed*.gguf" -o -iname "*bge*.gguf" -o -iname "*nomic*.gguf" -o -iname "*minilm*.gguf" \) 2>/dev/null | head -n 1 | xargs basename 2>/dev/null)
    fi
    if [ -z "$CHAT_MODEL" ]; then
        CHAT_MODEL=$(find "$MODELS_DIR" -maxdepth 1 -iname "*.gguf" ! -iname "*embed*" ! -iname "*bge*" ! -iname "*nomic*" ! -iname "*minilm*" 2>/dev/null | head -n 1 | xargs basename 2>/dev/null)
    fi

    if [ ! -f "$MODELS_DIR/$EMBED_MODEL" ] || [ ! -f "$MODELS_DIR/$CHAT_MODEL" ]; then
        echo -e "${C_YELLOW}[!] Active models not found in $MODELS_DIR.${C_RESET}"
        local do_quickstart="y"
        if [ -t 0 ]; then
            read -p "    Download and configure recommended starter models now? (Y/n): " do_quickstart
            do_quickstart=${do_quickstart:-y}
        fi
        if [[ "$do_quickstart" =~ ^[Yy] ]]; then
            if command -v wola.gt >/dev/null 2>&1; then
                wola.gt --quick-start
            else
                m_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
                python3 "$m_dir/wola.gt" --quick-start 2>/dev/null || python3 "$HOME/wola/bin/wola.gt" --quick-start
            fi
            [ -f "$CONFIG" ] && source "$CONFIG"
            if [ -z "$EMBED_MODEL" ]; then
                EMBED_MODEL=$(find "$MODELS_DIR" -maxdepth 1 \( -iname "*embed*.gguf" -o -iname "*bge*.gguf" -o -iname "*nomic*.gguf" -o -iname "*minilm*.gguf" \) 2>/dev/null | head -n 1 | xargs basename 2>/dev/null)
            fi
            if [ -z "$CHAT_MODEL" ]; then
                CHAT_MODEL=$(find "$MODELS_DIR" -maxdepth 1 -iname "*.gguf" ! -iname "*embed*" ! -iname "*bge*" ! -iname "*nomic*" ! -iname "*minilm*" 2>/dev/null | head -n 1 | xargs basename 2>/dev/null)
            fi
        fi
    fi

    if [ ! -f "$MODELS_DIR/$EMBED_MODEL" ]; then
        echo -e "${C_RED}[-] Error: Embedding model not found: $MODELS_DIR/$EMBED_MODEL${C_RESET}"
        echo "    Run 'wola.gt' or 'wola store' to download an embedding model."
        exit 1
    fi
    if [ ! -f "$MODELS_DIR/$CHAT_MODEL" ]; then
        echo -e "${C_RED}[-] Error: Chat model not found: $MODELS_DIR/$CHAT_MODEL${C_RESET}"
        echo "    Run 'wola.gt' or 'wola store' to download a chat model."
        exit 1
    fi

    # Compute optimal thread default if unspecified
    local detected_cores=$(nproc 2>/dev/null || echo 4)
    local optimal_threads=4
    [ "$detected_cores" -lt 4 ] && optimal_threads="$detected_cores"
    CHAT_THREADS="${CHAT_THREADS:-$optimal_threads}"
    EMBED_THREADS="${EMBED_THREADS:-2}"

    # Optimization flags: Flash Attention & memory pinning
    local FLASH_FLAG=""
    [ "${FLASH_ATTENTION:-auto}" != "off" ] && FLASH_FLAG="-fa ${FLASH_ATTENTION:-auto}"
    local MLOCK_FLAG=""
    [ "${MLOCK:-false}" = "true" ] && MLOCK_FLAG="--mlock"

    ensure_wola_layout
    LOCK="$RUN_DIR/wola.lock"
    touch "$LOCK"
    command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock
    echo -e "${C_GREEN}[*] Initializing Wola AI Node Engine (Flash-Attn: ${FLASH_ATTENTION:-auto}, Threads: ${CHAT_THREADS})...${C_RESET}"

    local runner="nohup"
    command -v setsid >/dev/null 2>&1 && runner="setsid -f"

    $runner "$BIN" -m "$MODELS_DIR/$EMBED_MODEL" \
           --embeddings \
           --host 127.0.0.1 \
           -c "${EMBED_CTX:-2048}" -b "${EMBED_BATCH:-512}" -ub "${EMBED_BATCH:-512}" \
           -t "$EMBED_THREADS" \
           $FLASH_FLAG $MLOCK_FLAG \
           --port "${EMBED_PORT:-8081}" > "$LOG_DIR/embed.log" 2>&1 &

    $runner "$BIN" -m "$MODELS_DIR/$CHAT_MODEL" \
           --host 127.0.0.1 \
           -c "${CHAT_CTX:-4096}" -b 512 -np "${CHAT_PARALLEL:-2}" \
           -t "$CHAT_THREADS" \
           $FLASH_FLAG $MLOCK_FLAG \
           --port "${CHAT_PORT:-8080}" > "$LOG_DIR/chat.log" 2>&1 &

    if ! wait_for_service "http://127.0.0.1:${EMBED_PORT:-8081}/health" "Embedding Engine (8081)" "llama-server.*${EMBED_PORT:-8081}"; then
        echo -e "${C_RED}[-] Embedding server failed to start.${C_RESET}"
        tail -n 10 "$LOG_DIR/embed.log"
        stop_node
        exit 1
    fi

    if ! wait_for_service "http://127.0.0.1:${CHAT_PORT:-8080}/health" "Chat LLM Engine (8080)" "llama-server.*${CHAT_PORT:-8080}"; then
        echo -e "${C_RED}[-] Chat server failed to start.${C_RESET}"
        tail -n 10 "$LOG_DIR/chat.log"
        stop_node
        exit 1
    fi

    local indexer_script="$LIB_DIR/indexer.py"
    [ ! -f "$indexer_script" ] && [ -f "$HOME/indexer.py" ] && indexer_script="$HOME/indexer.py"
    local agent_script="$LIB_DIR/agent.py"
    [ ! -f "$agent_script" ] && [ -f "$HOME/agent.py" ] && agent_script="$HOME/agent.py"

    $runner python3 "$indexer_script" > "$LOG_DIR/indexer.log" 2>&1 &
    $runner python3 "$agent_script" > "$LOG_DIR/agent.log" 2>&1 &

    local port="${AGENT_PORT:-5000}"
    if ! wait_for_service "http://127.0.0.1:${port}/health" "Agent API Gateway (${port})" "agent.py"; then
        echo -e "${C_RED}[-] Agent gateway failed to launch.${C_RESET}"
        tail -n 10 "$LOG_DIR/agent.log"
        stop_node
        exit 1
    fi

    echo -n -e "[*] Starting Autonomous Tunnel Watchdog (Cloudflare -> localhost.run -> serveo -> pinggy)... "
    local tdaemon=""
    if [ -x "${PREFIX:-/data/data/com.termux/files/usr}/bin/wola-tunnel-daemon" ]; then
        tdaemon="${PREFIX:-/data/data/com.termux/files/usr}/bin/wola-tunnel-daemon"
    elif [ -x "$(dirname "$0")/wola-tunnel-daemon" ]; then
        tdaemon="$(dirname "$0")/wola-tunnel-daemon"
    elif [ -x "$HOME/wola/bin/wola-tunnel-daemon" ]; then
        tdaemon="$HOME/wola/bin/wola-tunnel-daemon"
    fi

    TUNNEL_URL=""
    ACTIVE_PROVIDER=""
    if [ -n "$tdaemon" ]; then
        TUNNEL_URL=$("$tdaemon" start 2>/dev/null | tail -n 1)
        [ -f "$RUN_DIR/wola_provider" ] && ACTIVE_PROVIDER=$(cat "$RUN_DIR/wola_provider" 2>/dev/null | tr -d ' \n\r')
        [ -z "$ACTIVE_PROVIDER" ] && [ -f "$HOME/.wola_provider" ] && ACTIVE_PROVIDER=$(cat "$HOME/.wola_provider" 2>/dev/null | tr -d ' \n\r')
        [ -f "$RUN_DIR/wola_url" ] && [ -z "$TUNNEL_URL" ] && TUNNEL_URL=$(cat "$RUN_DIR/wola_url" 2>/dev/null | tr -d ' \n\r')
        [ -f "$HOME/.wola_url" ] && [ -z "$TUNNEL_URL" ] && TUNNEL_URL=$(cat "$HOME/.wola_url" 2>/dev/null | tr -d ' \n\r')
        echo -e "${C_GREEN}READY${C_RESET}"
    else
        echo -e "${C_YELLOW}SKIPPED (wola-tunnel-daemon missing)${C_RESET}"
    fi

    disown -a 2>/dev/null || true

    # Detect Tailscale and Local LAN addresses
    local ts_ip=""
    if command -v tailscale >/dev/null 2>&1; then
        ts_ip=$(tailscale ip -4 2>/dev/null | head -n 1)
    fi
    if [ -z "$ts_ip" ] && command -v ip >/dev/null 2>&1; then
        ts_ip=$(ip -4 addr show 2>/dev/null | grep -oE "100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}" | head -n 1)
    fi

    local lan_ip=""
    if command -v ip >/dev/null 2>&1; then
        lan_ip=$(ip -4 addr show 2>/dev/null | grep -oE "192\.168\.[0-9]{1,3}\.[0-9]{1,3}|10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]{1,3}\.[0-9]{1,3}" | grep -v "127.0.0.1" | head -n 1)
    fi

    echo -e "${C_CYAN}=================================================================${C_RESET}"
    echo -e "  ${C_BOLD}WOLA AI NODE ONLINE [SWITCH: ON]${C_RESET}"
    echo -e "${C_CYAN}=================================================================${C_RESET}"
    if [ -n "$ts_ip" ]; then
        echo -e "  ${C_BOLD}Tailscale Mesh  :${C_RESET} ${C_CYAN}http://${ts_ip}:${port}${C_RESET} (${C_GREEN}Tailscale Active${C_RESET})"
    fi
    if [ -n "$lan_ip" ]; then
        echo -e "  ${C_BOLD}Local / Hotspot :${C_RESET} ${C_CYAN}http://${lan_ip}:${port}${C_RESET}"
    fi
    if [ -n "$TUNNEL_URL" ]; then
        echo -e "  ${C_BOLD}Public Tunnel   :${C_RESET} ${C_GREEN}${TUNNEL_URL}${C_RESET} (${ACTIVE_PROVIDER})"
        echo -e "  ${C_BOLD}Tunnel API      :${C_RESET} ${C_GREEN}${TUNNEL_URL}/v1${C_RESET}"
    else
        echo -e "  ${C_YELLOW}Tunnel offline. Local API active at http://127.0.0.1:${port}/v1${C_RESET}"
    fi
    echo -e "  Chat Model      : ${C_YELLOW}${CHAT_MODEL}${C_RESET}"
    echo -e "  Embed Model     : ${C_YELLOW}${EMBED_MODEL}${C_RESET}"
    echo -e "  API Key         : sk-test"
    echo -e "${C_CYAN}-----------------------------------------------------------------${C_RESET}"
    echo -e "  Commands: ${C_BOLD}wola.d${C_RESET} | ${C_BOLD}wola.url${C_RESET} | ${C_BOLD}wola.chat${C_RESET} | ${C_BOLD}wola.th${C_RESET} | ${C_BOLD}wola.gt${C_RESET} | ${C_BOLD}wola.t${C_RESET} | ${C_BOLD}wola.rs${C_RESET} | ${C_BOLD}wola.k${C_RESET}"
    echo -e "${C_CYAN}=================================================================${C_RESET}"
}

stop_node() {
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        echo -e "${C_BOLD}Wolarc Stop Service${C_RESET}"
        echo "Cleanly terminates all running AI node processes and releases system resources."
        echo ""
        echo "Usage:"
        echo "  wola.stop          (Casual)"
        echo "  wola.k             (Technical)"
        echo "  wola stop / wola k"
        return 0
    fi

    if ! is_running && [ ! -f "$LOCK" ] && [ ! -f "$RUN_DIR/wola.lock" ] && [ ! -f "$HOME/.wola.lock" ]; then
        echo -e "${C_YELLOW}[-] Wola AI Node is ALREADY OFF.${C_RESET}"
        return 0
    fi
    echo -e "${C_YELLOW}[*] Shutting down all Wola services...${C_RESET}"
    pkill -9 -f "llama-server" 2>/dev/null || true
    pkill -9 -f "indexer.py" 2>/dev/null || true
    pkill -9 -f "agent.py" 2>/dev/null || true

    local tdaemon=""
    if [ -x "${PREFIX:-/data/data/com.termux/files/usr}/bin" ] && [ -x "${PREFIX:-/data/data/com.termux/files/usr}/bin/wola-tunnel-daemon" ]; then
        tdaemon="${PREFIX:-/data/data/com.termux/files/usr}/bin/wola-tunnel-daemon"
    elif [ -x "$(dirname "$0")/wola-tunnel-daemon" ]; then
        tdaemon="$(dirname "$0")/wola-tunnel-daemon"
    elif [ -x "$HOME/wola/bin/wola-tunnel-daemon" ]; then
        tdaemon="$HOME/wola/bin/wola-tunnel-daemon"
    fi
    [ -n "$tdaemon" ] && "$tdaemon" stop >/dev/null 2>&1
    pkill -9 -f "wola-tunnel-daemon" 2>/dev/null || true
    pkill -9 -f "cloudflared.*tunnel" 2>/dev/null || true
    pkill -9 -f "ssh.*localhost.run" 2>/dev/null || true
    pkill -9 -f "ssh.*serveo.net" 2>/dev/null || true
    pkill -9 -f "ssh.*pinggy" 2>/dev/null || true
    pkill -9 -f "wola-tui" 2>/dev/null || true

    rm -f "$LOCK" "$RUN_DIR/wola.lock" "$HOME/.wola.lock" \
          "$RUN_DIR/wola_url" "$RUN_DIR/wola_endpoint" "$RUN_DIR/wola_provider" \
          "$HOME/.wola_url" "$HOME/.wola_endpoint" "$HOME/.wola_provider" \
          "$HOME/.wola_tunnel_daemon.pid" 2>/dev/null || true
    rm -f "$RUN_DIR"/*.pid "$RUN_DIR"/*.lock 2>/dev/null || true

    command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock 2>/dev/null || true
    stty sane 2>/dev/null || true
    printf '\033[?25h\033[0m' 2>/dev/null || true

    echo -e "${C_GREEN}[+] [SWITCH: OFF] Services stopped and wake-lock released.${C_RESET}"
}

exit_node() {
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        echo -e "${C_BOLD}Wolarc Environment Exit & Reset${C_RESET}"
        echo "Cleanly stops all services, clears runtime locks/PIDs, releases wake-locks,"
        echo "and restores terminal state to avoid environment corruption."
        echo ""
        echo "Usage:"
        echo "  wola.exit          (Casual)"
        echo "  wola.x             (Technical)"
        echo "  wola exit / wola x"
        return 0
    fi

    echo -e "${C_YELLOW}[*] Performing clean exit and environment reset...${C_RESET}"
    stop_node >/dev/null 2>&1 || true

    # Clean runtime temporary files and residual locks
    rm -f "$RUN_DIR"/*.pid "$RUN_DIR"/*.lock 2>/dev/null || true
    rm -f /tmp/wola* /tmp/.wola* "${PREFIX:-/data/data/com.termux/files/usr}/tmp"/wola* 2>/dev/null || true
    rm -f "$HOME/.wola.lock" "$HOME/.wola_url" "$HOME/.wola_endpoint" "$HOME/.wola_provider" "$HOME/.wola_tunnel_daemon.pid" 2>/dev/null || true

    # Release any lingering wake locks
    command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock 2>/dev/null || true

    # Restore clean terminal mode
    stty sane 2>/dev/null || true
    printf '\033[?25h\033[0m' 2>/dev/null || true

    echo -e "${C_GREEN}[+] [SWITCH: OFF] Wola environment cleanly exited and terminal state restored.${C_RESET}"
}

restart_node() {
    local refresh=false
    while [ $# -gt 0 ]; do
        case "$1" in
            "-h"|"--help")
                echo -e "${C_BOLD}Wolarc Restart Service${C_RESET}"
                echo "Performs a graceful stop, resource cleanup, and restart of all node daemons."
                echo ""
                echo "Usage:"
                echo "  wola.restart [-r|--refresh]    (Casual)"
                echo "  wola.rs [-r|--refresh]         (Technical)"
                echo "  wola restart [-r|--refresh] / wola rs [-r]"
                echo ""
                echo "Options:"
                echo "  -r, --refresh   Flush Python cache, update/metrics cache, and reload ~/.wolarc"
                return 0
                ;;
            "-r"|"--refresh")
                refresh=true
                ;;
        esac
        shift
    done

    echo -e "${C_YELLOW}[*] Restarting Wola AI Node stack...${C_RESET}"
    if [ "$refresh" = true ]; then
        echo -e "    [*] Refreshing runtime environment and flushing caches..."
        rm -rf "$HOME/__pycache__" "$LIB_DIR/__pycache__" 2>/dev/null || true
        rm -f "$HOME/.wola_metrics.json" "$HOME/.wola_update_cache.json" "$HOME/.wola_bench_cache.json" 2>/dev/null || true
        rm -f /tmp/wola* /tmp/.wola* "${PREFIX:-/data/data/com.termux/files/usr}/tmp"/wola* 2>/dev/null || true
        stty sane 2>/dev/null || true
        printf '\033[?25h\033[0m' 2>/dev/null || true
        [ -f "$CONFIG" ] && source "$CONFIG" 2>/dev/null || true
    fi

    stop_node
    sleep 2
    start_node
}

status_node() {
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        echo -e "${C_BOLD}Wolarc Status Check${C_RESET}"
        echo "Inspects active process PIDs, listening ports, switch status, and endpoints."
        echo ""
        echo "Usage:"
        echo "  wola.check         (Casual)"
        echo "  wola.status        (Technical)"
        echo "  wola check / wola status"
        return 0
    fi

    echo -e "${C_CYAN}=================================================================${C_RESET}"
    echo -e "                    WOLA SERVICE STATUS"
    echo -e "${C_CYAN}=================================================================${C_RESET}"
    if [ -f "$LOCK" ]; then
        echo -e "  Switch State : ${C_GREEN}ON${C_RESET}"
    else
        echo -e "  Switch State : ${C_RED}OFF${C_RESET}"
    fi
    
    local c_pid=$(pgrep -f "llama-server.*${CHAT_PORT:-8080}" | head -n 1)
    local e_pid=$(pgrep -f "llama-server.*${EMBED_PORT:-8081}" | head -n 1)
    local a_pid=$(pgrep -f "agent.py" | head -n 1)
    local i_pid=$(pgrep -f "indexer.py" | head -n 1)
    local t_pid=$(pgrep -f "wola-tunnel-daemon" | head -n 1)
    [ -z "$t_pid" ] && t_pid=$(pgrep -f "cloudflared.*tunnel|ssh.*(localhost.run|serveo.net|pinggy.io)" | head -n 1)

    echo -e "  • Chat Server  (8080): $([ -n "$c_pid" ] && echo -e "${C_GREEN}Active (PID $c_pid)${C_RESET}" || echo -e "${C_RED}Stopped${C_RESET}")"
    echo -e "  • Embed Server (8081): $([ -n "$e_pid" ] && echo -e "${C_GREEN}Active (PID $e_pid)${C_RESET}" || echo -e "${C_RED}Stopped${C_RESET}")"
    echo -e "  • Agent API    (5000): $([ -n "$a_pid" ] && echo -e "${C_GREEN}Active (PID $a_pid)${C_RESET}" || echo -e "${C_RED}Stopped${C_RESET}")"
    echo -e "  • Indexer Daemon     : $([ -n "$i_pid" ] && echo -e "${C_GREEN}Active (PID $i_pid)${C_RESET}" || echo -e "${C_RED}Stopped${C_RESET}")"
    echo -e "  • Tunnel Daemon      : $([ -n "$t_pid" ] && echo -e "${C_GREEN}Active (PID $t_pid)${C_RESET}" || echo -e "${C_RED}Stopped${C_RESET}")"

    local disp_url=""
    local disp_prov=""
    if [ -f "$RUN_DIR/wola_url" ]; then
        disp_url=$(cat "$RUN_DIR/wola_url" 2>/dev/null)
        disp_prov=$(cat "$RUN_DIR/wola_provider" 2>/dev/null)
    elif [ -f "$HOME/.wola_url" ]; then
        disp_url=$(cat "$HOME/.wola_url" 2>/dev/null)
        disp_prov=$(cat "$HOME/.wola_provider" 2>/dev/null)
    fi
    if [ -n "$disp_url" ]; then
        echo -e "  • Tunnel URL         : ${C_GREEN}${disp_url}${C_RESET} (${C_DIM}${disp_prov:-auto}${C_RESET})"
    fi

    local ts_ip=""
    command -v tailscale >/dev/null 2>&1 && ts_ip=$(tailscale ip -4 2>/dev/null | head -n 1)
    [ -z "$ts_ip" ] && command -v ip >/dev/null 2>&1 && ts_ip=$(ip -4 addr show 2>/dev/null | grep -oE "100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}" | head -n 1)
    if [ -n "$ts_ip" ]; then
        echo -e "  • Tailscale Mesh IP  : ${C_CYAN}http://${ts_ip}:${AGENT_PORT:-5000}${C_RESET} (${C_GREEN}Active${C_RESET})"
    fi
    echo -e "${C_CYAN}=================================================================${C_RESET}"
}

TARGET_PURGE="${PREFIX:-/data/data/com.termux/files/usr}/bin/wola.purge"
[ ! -x "$TARGET_PURGE" ] && TARGET_PURGE="$(dirname "$0")/wola.purge"
[ ! -x "$TARGET_PURGE" ] && TARGET_PURGE="wola.purge"

handle_tui_toggle() {
    case "$1" in
        "on"|"enable"|"1"|"true")
            python3 -c "
import re, os
path = os.path.expanduser('~/.wolarc')
lines = []
if os.path.exists(path):
    with open(path) as f: lines = f.readlines()
pat = re.compile(r'^\s*ENABLE_TUI=.*$')
if any(pat.match(l) for l in lines):
    lines = [f'ENABLE_TUI=\"true\"\n' if pat.match(l) else l for l in lines]
else:
    lines.append('ENABLE_TUI=\"true\"\n')
with open(path, 'w') as f: f.writelines(lines)
"
            echo -e "${C_GREEN}[+] Go Bubble Tea TUI ENABLED.${C_RESET}"
            echo "    'wola' will now launch the interactive TUI."
            ;;
        "off"|"disable"|"0"|"false")
            python3 -c "
import re, os
path = os.path.expanduser('~/.wolarc')
lines = []
if os.path.exists(path):
    with open(path) as f: lines = f.readlines()
pat = re.compile(r'^\s*ENABLE_TUI=.*$')
if any(pat.match(l) for l in lines):
    lines = [f'ENABLE_TUI=\"false\"\n' if pat.match(l) else l for l in lines]
else:
    lines.append('ENABLE_TUI=\"false\"\n')
with open(path, 'w') as f: f.writelines(lines)
"
            echo -e "${C_YELLOW}[-] Go Bubble Tea TUI DISABLED.${C_RESET}"
            echo "    'wola' will now use the classic CLI command suite."
            ;;
        "status"|*)
            echo -e "${C_BOLD}Go Bubble Tea TUI Status:${C_RESET} ${ENABLE_TUI:-true}"
            echo "Usage: wola tui [on|off|status] (or wola ui [on|off|status])"
            ;;
    esac
}

INVOCATION=$(basename "$0")
case "$INVOCATION" in
    "wola.r"|"wola.start")          start_node "$@" ;;
    "wola.k"|"wola.stop")           stop_node "$@" ;;
    "wola.rs"|"wola.restart")       restart_node "$@" ;;
    "wola.x"|"wola.exit")           exit_node "$@" ;;
    "wola.status"|"wola.check")     status_node "$@" ;;
    "wola.d"|"wola.dashboard")      exec "$PREFIX/bin/wola.d" "$@" ;;
    "wola.c"|"wola.chat")           exec "$PREFIX/bin/wola.chat" "$@" ;;
    "wola.m"|"wola.models")         exec "$PREFIX/bin/wola.m" "$@" ;;
    "wola.gt"|"wola.store")         exec "$PREFIX/bin/wola.gt" "$@" ;;
    "wola.i"|"wola.knowledge")      exec "$PREFIX/bin/wola.i" "$@" ;;
    "wola.b"|"wola.bench")          exec "$PREFIX/bin/wola.bench" "$@" ;;
    "wola.l"|"wola.log")            exec "$PREFIX/bin/wola.log" "$@" ;;
    "wola.th"|"wola.think")         exec "$PREFIX/bin/wola.th" "$@" ;;
    "wola.url"|"wola.link")         exec "$PREFIX/bin/wola.url" "$@" ;;
    "wola.local"|"wola.hotspot")    exec "$PREFIX/bin/wola.url" local "$@" ;;
    "wola.ts"|"wola.tailscale")     exec "$PREFIX/bin/wola.url" tailscale "$@" ;;
    "wola.t"|"wola.config")         exec "$PREFIX/bin/wola.t" "$@" ;;
    "wola.u"|"wola.update")         exec "$PREFIX/bin/wola.u" "$@" ;;
    "wola.purge"|"wola.uninstall")  exec "$TARGET_PURGE" "$@" ;;
    "wola.h"|"wola.help"|"wola-h")  exec "$PREFIX/bin/wola-h" "$@" ;;
    "wola.tui"|"wola.ui")           exec "$PREFIX/bin/wola-tui" "$@" ;;
    *)
        # Invoked as 'wola' or general dispatcher
        if [ $# -eq 0 ]; then
            if is_tui_enabled && command -v wola-tui >/dev/null 2>&1; then
                exec wola-tui
            else
                exec "$PREFIX/bin/wola-h"
            fi
        fi

        case "$1" in
            "r"|"start")               shift; start_node "$@" ;;
            "k"|"stop")                shift; stop_node "$@" ;;
            "rs"|"restart")            shift; restart_node "$@" ;;
            "x"|"exit"|"quit"|"q")     shift; exit_node "$@" ;;
            "status"|"check")          shift; status_node "$@" ;;
            "d"|"dashboard")
                shift
                if [ $# -gt 0 ]; then
                    exec "$PREFIX/bin/wola.d" "$@"
                fi
                if is_tui_enabled && command -v wola-tui >/dev/null 2>&1; then
                    exec wola-tui dashboard
                fi
                exec "$PREFIX/bin/wola.d" "$@"
                ;;
            "c"|"chat")
                shift
                if is_tui_enabled && command -v wola-tui >/dev/null 2>&1 && [ $# -eq 0 ]; then
                    exec wola-tui chat
                fi
                exec "$PREFIX/bin/wola.chat" "$@"
                ;;
            "m"|"models")
                shift
                if is_tui_enabled && command -v wola-tui >/dev/null 2>&1 && [ $# -eq 0 ]; then
                    exec wola-tui models
                fi
                exec "$PREFIX/bin/wola.m" "$@"
                ;;
            "gt"|"store")
                shift; exec "$PREFIX/bin/wola.gt" "$@"
                ;;
            "i"|"knowledge")
                shift
                if is_tui_enabled && command -v wola-tui >/dev/null 2>&1 && [ $# -eq 0 ]; then
                    exec wola-tui knowledge
                fi
                exec "$PREFIX/bin/wola.i" "$@"
                ;;
            "b"|"bench")
                shift; exec "$PREFIX/bin/wola.bench" "$@"
                ;;
            "l"|"log")
                shift
                if is_tui_enabled && command -v wola-tui >/dev/null 2>&1 && [ $# -eq 0 ]; then
                    exec wola-tui logs
                fi
                exec "$PREFIX/bin/wola.log" "$@"
                ;;
            "th"|"think")
                shift; exec "$PREFIX/bin/wola.th" "$@"
                ;;
            "url"|"link")
                shift; exec "$PREFIX/bin/wola.url" "$@"
                ;;
            "local"|"hotspot")
                shift; exec "$PREFIX/bin/wola.url" local "$@"
                ;;
            "ts"|"tailscale")
                shift; exec "$PREFIX/bin/wola.url" tailscale "$@"
                ;;
            "t"|"config")
                shift; exec "$PREFIX/bin/wola.t" "$@"
                ;;
            "u"|"update")
                shift; exec "$PREFIX/bin/wola.u" "$@"
                ;;
            "purge"|"uninstall")
                shift; exec "$TARGET_PURGE" "$@"
                ;;
            "h"|"help")
                shift; exec "$PREFIX/bin/wola-h" "$@"
                ;;
            "tui"|"ui")
                shift; handle_tui_toggle "$@" ;;
            *)
                if is_tui_enabled && command -v wola-tui >/dev/null 2>&1; then
                    exec wola-tui "$@"
                fi
                echo -e "${C_BOLD}Wola Autonomous AI Node Suite${C_RESET}"
                echo "Technical Commands : wola.r | wola.k | wola.rs | wola.x | wola.status | wola.d | wola.c | wola.m | wola.gt | wola.i | wola.b | wola.l | wola.th | wola.url | wola.local | wola.t | wola.u | wola.purge | wola.h"
                echo "Casual Commands    : wola.start | wola.stop | wola.restart | wola.exit | wola.check | wola.dashboard | wola.chat | wola.models | wola.store | wola.knowledge | wola.bench | wola.log | wola.think | wola.link | wola.hotspot | wola.config | wola.update | wola.uninstall | wola.help"
                ;;
        esac
        ;;
esac
