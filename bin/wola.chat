#!/data/data/com.termux/files/usr/bin/python3
import os, sys, requests, json, time, readline

C_RESET   = "\033[0m"
C_BOLD    = "\033[1m"
C_DIM     = "\033[2m"
C_GREEN   = "\033[1;32m"
C_RED     = "\033[1;31m"
C_YELLOW  = "\033[1;33m"
C_CYAN    = "\033[1;36m"
C_MAGENTA = "\033[1;35m"

CONFIG_FILE = os.path.expanduser("~/.wolarc")
AGENT_PORT = 5000

if os.path.exists(CONFIG_FILE):
    try:
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                if line.startswith("AGENT_PORT="):
                    AGENT_PORT = int(line.split("=", 1)[1].strip("\"' \n"))
    except Exception:
        pass

API_URL = f"http://127.0.0.1:{AGENT_PORT}/v1/chat/completions"
STATUS_URL = f"http://127.0.0.1:{AGENT_PORT}/v1/status"

def check_gateway():
    try:
        r = requests.get(f"http://127.0.0.1:{AGENT_PORT}/health", timeout=2)
        return r.status_code == 200
    except Exception:
        return False

def get_status_info():
    try:
        r = requests.get(STATUS_URL, timeout=2)
        if r.status_code == 200:
            return r.json()
    except Exception:
        pass
    return {}

def print_banner(status):
    sys.stdout.write("\033[2J\033[H")
    kb_info = status.get("knowledge_base", {})
    docs = kb_info.get("documents", 0)
    chunks = kb_info.get("chunks", 0)
    convs = kb_info.get("conversation_memories", 0)
    think_on = status.get("enable_thinking", True)
    think_str = f"{C_GREEN}ON{C_RESET}" if think_on else f"{C_YELLOW}OFF (fast){C_RESET}"

    print(f"{C_CYAN}╭────────────────────────────────────────────────────────────────╮{C_RESET}")
    print(f"{C_CYAN}│{C_RESET}                 {C_BOLD}WOLARC TERMINAL CHAT CLIENT{C_RESET}                    {C_CYAN}│{C_RESET}")
    print(f"{C_CYAN}╰────────────────────────────────────────────────────────────────╯{C_RESET}")
    print(f"  Connected to local Agent Gateway ({C_GREEN}127.0.0.1:{AGENT_PORT}{C_RESET})")
    print(f"  Vector Knowledge Base: {C_BOLD}{docs}{C_RESET} documents ({chunks} chunks | {convs} chat memories)")
    print(f"  Thinking Mechanism   : {think_str}")
    print(f"  {C_DIM}Commands: /think [on|off], /notes, /clear, /exit{C_RESET}")
    print(f"{C_CYAN}──────────────────────────────────────────────────────────────────{C_RESET}\n")

def stream_chat(history, session_id):
    payload = {
        "messages": history,
        "stream": True,
        "max_tokens": 2048,
        "session_id": session_id
    }
    
    start_time = time.time()
    token_count = 0
    full_response = ""
    in_think = False

    try:
        res = requests.post(API_URL, json=payload, stream=True, timeout=120)
        if res.status_code != 200:
            print(f"{C_RED}[-] API returned error HTTP {res.status_code}{C_RESET}")
            return ""

        sys.stdout.write(f"\n{C_GREEN}{C_BOLD}Wola > {C_RESET}")
        sys.stdout.flush()

        for line in res.iter_lines():
            if not line:
                continue
            decoded = line.decode("utf-8", errors="replace")
            if decoded.startswith("data: "):
                data_str = decoded[6:].strip()
                if data_str == "[DONE]":
                    break
                try:
                    chunk = json.loads(data_str)
                    choices = chunk.get("choices", [])
                    if choices:
                        delta = choices[0].get("delta", {})
                        token = delta.get("content", "") or delta.get("reasoning_content", "")
                        if token:
                            token_count += 1
                            full_response += token
                            # Handle thinking tag formatting in stream
                            if "<think>" in token:
                                sys.stdout.write(f"\n{C_MAGENTA}{C_DIM}[Thinking...] ")
                                in_think = True
                                token = token.replace("<think>", "")
                            if "</think>" in token:
                                in_think = False
                                token = token.replace("</think>", f"{C_RESET}\n\n{C_GREEN}")
                            
                            sys.stdout.write(token)
                            sys.stdout.flush()
                except Exception:
                    pass

        elapsed = max(0.01, time.time() - start_time)
        tok_speed = token_count / elapsed
        sys.stdout.write(f"{C_RESET}\n")
        print(f"  {C_DIM}• {token_count} tokens in {elapsed:.1f}s ({tok_speed:.1f} tok/s | Saved to chats){C_RESET}\n")
        return full_response

    except Exception as e:
        print(f"\n{C_RED}[-] Connection error: {e}{C_RESET}\n")
        return ""

def main():
    if not check_gateway():
        print(f"{C_RED}[-] Error: Wola Agent Gateway (Port {AGENT_PORT}) is not reachable.{C_RESET}")
        print("    Start the Wola stack first with: 'wola.r'")
        sys.exit(1)

    session_id = f"cli_{time.strftime('%Y%m%d_%H%M%S')}"
    status = get_status_info()
    print_banner(status)

    history = []

    while True:
        try:
            user_input = input(f"{C_BOLD}You > {C_RESET}").strip()
            if not user_input:
                continue

            if user_input.lower() in ["/exit", "/quit", "/q", "exit", "quit"]:
                print("\nSession ended. Dialogue saved to local chats directory.")
                break
            elif user_input.lower() in ["/clear", "/c"]:
                history = []
                session_id = f"cli_{time.strftime('%Y%m%d_%H%M%S')}"
                print(f"{C_YELLOW}[*] Conversation history cleared. New session started.{C_RESET}\n")
                continue
            elif user_input.lower().startswith("/think"):
                parts = user_input.split()
                desired = None
                if len(parts) > 1:
                    desired = parts[1].lower() in ["on", "true", "1", "enable"]
                else:
                    cur_st = get_status_info()
                    desired = not cur_st.get("enable_thinking", True)
                try:
                    r = requests.post(f"http://127.0.0.1:{AGENT_PORT}/v1/thinking", json={"enable_thinking": desired}, timeout=3)
                    if r.status_code == 200:
                        state_lbl = f"{C_GREEN}ENABLED{C_RESET}" if desired else f"{C_YELLOW}DISABLED (fast answer mode){C_RESET}"
                        print(f"[*] Thinking mechanism {state_lbl}.\n")
                except Exception as e:
                    print(f"[-] Could not toggle thinking: {e}\n")
                continue
            elif user_input.lower() in ["/notes", "/n"]:
                os.system("wola.i status")
                print("")
                continue

            history.append({"role": "user", "content": user_input})
            assistant_reply = stream_chat(history, session_id)
            if assistant_reply:
                history.append({"role": "assistant", "content": assistant_reply})

        except (KeyboardInterrupt, EOFError):
            print("\nExiting chat. Dialogue saved to local chats directory.")
            break

if __name__ == "__main__":
    main()
