# Paths & Binaries
LLAMA_BIN="$HOME/llama.cpp/build/bin/llama-server"
MODELS_DIR="$HOME/models"
KNOWLEDGE_DIR="$HOME/storage/shared/Documents/agent_knowledge"
DB_FILE="$HOME/knowledge_db.json"
METRICS_FILE="$HOME/.wola_metrics.json"

# Active Models
CHAT_MODEL=""
EMBED_MODEL=""

# Ports & Sockets
CHAT_PORT="8080"
EMBED_PORT="8081"
AGENT_PORT="5000"

# Compute & Hardware Optimizations
CHAT_THREADS="4"
EMBED_THREADS="2"
CHAT_CTX="4096"
EMBED_CTX="2048"
FLASH_ATTENTION="auto" # 'auto', 'on', or 'off' (cuts RAM footprint and boosts prompt eval)
MLOCK="false"          # 'true' pins model weights in RAM to prevent Android OS swapping
CHAT_PARALLEL="2"      # Number of concurrent parallel request slots (prevents remote/local lockout)

# Tunnel Provider
TUNNEL_PROVIDER="auto" # 'auto' (fallback chain), 'localhost.run', 'serveo', or 'pinggy'

# Inference & RAG Parameters
TEMPERATURE="0.3"
SIMILARITY_THRESHOLD="0.65"
TOP_K="2"
SYSTEM_PROMPT="You are an intelligent assistant. Ground facts using the provided notes, but blend them with your own base intelligence."
