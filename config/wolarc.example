# Paths & Binaries
LLAMA_BIN="$HOME/llama.cpp/build/bin/llama-server"
MODELS_DIR="$HOME/models"
KNOWLEDGE_DIR="$HOME/storage/shared/Documents/agent_knowledge"
CHATS_DIR="$HOME/storage/shared/Documents/agent_chats"
DB_FILE="$HOME/knowledge_db.json"
METRICS_FILE="$HOME/.wola_metrics.json"

# Active Models
CHAT_MODEL=""
EMBED_MODEL=""

# Ports & Sockets
CHAT_PORT="8080"
EMBED_PORT="8081"
AGENT_PORT="5000"

# Compute & Hardware Optimizations
CHAT_THREADS="4"
EMBED_THREADS="2"
CHAT_CTX="4096"
EMBED_CTX="2048"
FLASH_ATTENTION="auto" # 'auto', 'on', or 'off' (cuts RAM footprint and boosts prompt eval)
MLOCK="false"          # 'true' pins model weights in RAM to prevent Android OS swapping
CHAT_PARALLEL="2"      # Number of concurrent parallel request slots (prevents remote/local lockout)

# Tunnel Provider
TUNNEL_PROVIDER="auto" # 'auto' (fallback chain), 'localhost.run', 'serveo', or 'pinggy'

# Inference & RAG Parameters
TEMPERATURE="0.6"
SIMILARITY_THRESHOLD="0.50"
TOP_K="2"
SYSTEM_PROMPT="You are an intelligent, perceptive assistant. Answer using your own rich knowledge base, reasoning, and creativity. When personal background notes or memories are available, weave them naturally into your response to personalize it without robotic quotes or disclaimers."

# Reasoning & Thinking Mechanism
ENABLE_THINKING="true" # 'true' allows reasoning models to emit <think> chains; 'false' turns off thinking to save compute, RAM & latency

# User Interface Preferences
ENABLE_TUI="true"       # 'true' launches Go Bubble Tea TUI; 'false' uses classic CLI suite


